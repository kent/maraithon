if [[ ! "${protocol_revision}" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
  echo "Refusing an invalid runtime protocol revision: ${protocol_revision}" >&2
  echo "MARAITHON_RUNTIME_PROTOCOL_REVISION must be exactly 40 or 64 lowercase hexadecimal characters" >&2
  exit 64
fi

# CI supplies this explicitly; local deploys reuse the current public key so
# they do not require a separately persisted operator environment variable.
if [[ -z "${agent_termination_attestation_public_key}" ]]; then
  if ! deployed_runtime_service_json="$(
    gcloud run services describe "${runtime_service}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"; then
    echo "Unable to inspect the deployed runtime service for its Agent termination attestation public key" >&2
    exit 64
  fi

  if ! deployed_runtime_serving_revision="$(
    jq -er '
      [.status.traffic[]? | select((.percent // 0) > 0)] as $active |
      select(($active | length) == 1 and $active[0].percent == 100) |
      $active[0].revisionName | select(type == "string" and length > 0)
    ' <<<"${deployed_runtime_service_json}"
  )"; then
    echo "Unable to reuse the Agent termination attestation public key without one exact 100% serving runtime revision" >&2
    exit 64
  fi

  if ! deployed_runtime_revision_json="$(
    gcloud run revisions describe "${deployed_runtime_serving_revision}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"; then
    echo "Unable to inspect the 100% serving runtime revision for its Agent termination attestation public key" >&2
    exit 64
  fi

  if ! agent_termination_attestation_public_key="$(
    jq -er --arg name AGENT_TERMINATION_ATTESTATION_PUBLIC_KEY '
      [
        .spec.containers[]?.env[]?
        | select(.name == $name)
        | .value
        | select(type == "string")
      ]
      | if length == 1 then .[0] else empty end
    ' <<<"${deployed_runtime_revision_json}"
  )"; then
    echo "Unable to reuse the Agent termination attestation public key from the 100% serving runtime revision" >&2
    exit 64
  fi
fi

if [[ "${exact_runtime_enabled}" == "true" && ! "${agent_termination_attestation_public_key}" =~ ^[[:xdigit:]]{64}$ ]]; then
  echo "Refusing exact runtime without a 32-byte Agent termination attestation public key" >&2
  exit 64
fi

revision="$(git -C "${ROOT_DIR}" rev-parse HEAD)"

if [[ -n "${expected_controller_revision}" &&
      ( ! "${expected_controller_revision}" =~ ^[0-9a-f]{40}$ ||
        "${revision}" != "${expected_controller_revision}" ) ]]; then
  echo "The checked-out deploy controller does not match MARAITHON_DEPLOYMENT_CONTROLLER_REVISION" >&2
  echo "Expected: ${expected_controller_revision}; checked out: ${revision}" >&2
  exit 64
fi

project_number="$(gcloud projects describe "${project}" --format='value(projectNumber)')"
connection="${project}:${region}:${database_instance}"
socket_dir="/cloudsql/${connection}"
image_repository="${region}-docker.pkg.dev/${project}/${repository}/${service}"
web_host="${service}-${project_number}.${region}.run.app"
gmail_pubsub_project="${MARAITHON_GMAIL_PUBSUB_PROJECT:-orchestrator-483621}"
gmail_topic_id="${MARAITHON_GMAIL_PUBSUB_TOPIC_ID:-maraithon-gmail-push}"
gmail_subscription_id="${MARAITHON_GMAIL_PUBSUB_SUBSCRIPTION_ID:-maraithon-gmail-push-webhook}"
gmail_topic="projects/${gmail_pubsub_project}/topics/${gmail_topic_id}"
gmail_push_endpoint="https://maraithon.com/webhooks/google/gmail"

common_env="CLOUD_SQL_SOCKET_DIR=${socket_dir},DATABASE_TLS_MODE=private_network_override,DATABASE_TLS_INSECURE_CONFIRMATION=I_ACKNOWLEDGE_DATABASE_TLS_IS_NOT_VERIFIED,DATABASE_TLS_INSECURE_REASON=gcp_cloud_sql_unix_socket,PHX_HOST=maraithon.com,PRIMARY_ADMIN_EMAIL=kent@voteagora.com,LLM_PROVIDER=openrouter,LLM_MODEL=moonshotai/kimi-k3,OPENROUTER_CHAT_MODEL=moonshotai/kimi-k3,OPENROUTER_FAST_MODEL=moonshotai/kimi-k3,OPENROUTER_ROUTING_MODEL=moonshotai/kimi-k3,OPENROUTER_REASONING_EFFORT=high,LLM_BRIEF_REASONING_EFFORT=high,LLM_MAX_CONCURRENCY=3,LLM_REASONING_MAX_CONCURRENCY=3,SOURCE_FANOUT_TENANT_MAX_CONCURRENCY=3,GOOGLE_REDIRECT_URI=https://maraithon.com/auth/google/callback,GOOGLE_CALENDAR_WEBHOOK_URL=https://maraithon.com/webhooks/google/calendar,GOOGLE_PUBSUB_TOPIC=${gmail_topic},GITHUB_REDIRECT_URI=https://maraithon.com/auth/github/callback,SLACK_REDIRECT_URI=https://maraithon.com/auth/slack/callback,NOTAUI_REDIRECT_URI=https://maraithon.com/auth/notaui/callback,EXACT_AGENT_RUNTIME_ENABLED=${exact_runtime_enabled},MULTINODE_COORDINATION_ENABLED=${coordination_enabled},AGENT_TERMINATION_ATTESTATION_PUBLIC_KEY=${agent_termination_attestation_public_key},GIT_SHA=${protocol_revision},DB_QUERY_TIMEOUT_MS=30000,DATABASE_POOL_MODE=session"
maintenance_env="${common_env},MARAITHON_PROCESS_ROLE=maintenance,POOL_SIZE=2"
runtime_env="${common_env},MARAITHON_PROCESS_ROLE=runtime,POOL_SIZE=16,PHX_SERVER=true,DURABLE_PAYLOAD_BINDING_CURRENT_TAG=HMAC.SHA256.V1,OPENROUTER_HTTP_REFERER=https://maraithon.com,OPENROUTER_APP_TITLE=Maraithon"
web_env="${common_env},MARAITHON_PROCESS_ROLE=web,POOL_SIZE=8,PHX_SERVER=true,DURABLE_PAYLOAD_BINDING_CURRENT_TAG=HMAC.SHA256.V1,OPENROUTER_HTTP_REFERER=https://maraithon.com,OPENROUTER_APP_TITLE=Maraithon"

case "${deployment_resume_phase}" in
  new | handoff | deploying | activating | retarget | stable)
    ;;
  *)
    echo "Invalid MARAITHON_DEPLOYMENT_RESUME_PHASE: ${deployment_resume_phase}" >&2
    echo "Expected one of: new, handoff, deploying, activating, retarget, stable" >&2
    exit 64
    ;;
esac

revision_suffix_generated=false

if [[ -z "${revision_suffix}" ]]; then
  if [[ "${deployment_resume_phase}" != "new" &&
        "${deployment_resume_phase}" != "retarget" ]]; then
    echo "A resumed deployment requires MARAITHON_GCP_REVISION_SUFFIX" >&2
    exit 64
  fi

  if [[ -n "${GITHUB_RUN_ID:-}" && "${GITHUB_RUN_ID}" =~ ^[0-9]+$ ]]; then
    github_run_attempt="${GITHUB_RUN_ATTEMPT:-1}"
    if [[ ! "${github_run_attempt}" =~ ^[0-9]+$ ]]; then
      echo "Invalid GITHUB_RUN_ATTEMPT: ${github_run_attempt}" >&2
      exit 64
    fi
    revision_suffix="d-${revision:0:8}-g${GITHUB_RUN_ID}-a${github_run_attempt}"
  else
    deployment_nonce="$(
      printf '%s' "${revision}-$(date -u +%Y%m%d%H%M%S)-$$-${RANDOM}" |
        git -C "${ROOT_DIR}" hash-object --stdin
    )"
    revision_suffix="d-${revision:0:8}-${deployment_nonce:0:12}"
  fi
  revision_suffix_generated=true
fi

case "${deployment_resume_phase}" in
  handoff | deploying | activating | stable)
    if [[ -z "${resume_secret_versions}" ||
          -z "${resume_config_manifest}" ||
          -z "${expected_controller_revision}" ]]; then
      echo "Recovery phase ${deployment_resume_phase} requires the original controller revision, secret snapshot, and deployment config manifest" >&2
      exit 64
    fi
    ;;
esac

if [[ "${deployment_resume_phase}" != "new" &&
      ! "${resume_image_digest}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
  echo "A resumed deployment requires MARAITHON_DEPLOYMENT_IMAGE_DIGEST=sha256:<64 lowercase hex characters>" >&2
  exit 64
fi

# Secret environment variables are resolved when a Cloud Run instance starts.
# Resolve every alias once and bind a numeric version so a stable revision or
# retained migration job cannot silently change credentials after a restart.
resolve_secret_version() {
  local secret_name="$1"
  local secret_json
  local resource_name
  local version
  local expected_suffix

  if ! secret_json="$(
    gcloud secrets versions describe latest \
      --secret "${secret_name}" \
      --project "${project}" \
      --format=json
  )"; then
    echo "Unable to resolve the current Secret Manager version for ${secret_name}" >&2
    return 1
  fi

  if ! resource_name="$(
    jq -er 'select(.state == "ENABLED") | .name | select(type == "string")' \
      <<<"${secret_json}"
  )"; then
    echo "The latest Secret Manager version for ${secret_name} is not enabled" >&2
    return 1
  fi

  version="${resource_name##*/}"
  expected_suffix="/secrets/${secret_name}/versions/${version}"

  if [[ ! "${version}" =~ ^[1-9][0-9]*$ ||
        "${resource_name}" != *"${expected_suffix}" ]]; then
    echo "Secret Manager returned an invalid version identity for ${secret_name}" >&2
    return 1
  fi

  printf '%s\n' "${version}"
}

secret_version_from_snapshot() {
  local secret_name="$1"
  local snapshot_entry
  local entry_name
  local entry_version
  local matched_version=""
  local match_count=0
  local snapshot_entries=()

  IFS=',' read -r -a snapshot_entries <<<"${resume_secret_versions}"

  for snapshot_entry in "${snapshot_entries[@]}"; do
    entry_name="${snapshot_entry%%=*}"
    entry_version="${snapshot_entry#*=}"

    if [[ "${entry_name}" == "${secret_name}" ]]; then
      matched_version="${entry_version}"
      match_count=$((match_count + 1))
    fi
  done

  if [[ "${match_count}" -ne 1 || ! "${matched_version}" =~ ^[1-9][0-9]*$ ]]; then
    echo "Recovery secret snapshot must name ${secret_name} exactly once with a numeric version" >&2
    return 1
  fi

  if [[ "$(
    gcloud secrets versions describe "${matched_version}" \
      --secret "${secret_name}" \
      --project "${project}" \
      --format='value(state)'
  )" != "ENABLED" ]]; then
    echo "Recovery secret ${secret_name}:${matched_version} is not enabled" >&2
    return 1
  fi

  printf '%s\n' "${matched_version}"
}

deployment_secret_version() {
  local secret_name="$1"

  if [[ -n "${resume_secret_versions}" ]]; then
    secret_version_from_snapshot "${secret_name}"
  else
    resolve_secret_version "${secret_name}"
  fi
}

verify_cloud_build_upload_boundary() {
  local upload_files
  local ignored_files
  local ignored_uploads
  local required_path
  local required_paths=(
    .gcloudignore
    .gitignore
    Dockerfile
    mix.exs
    mix.lock
    entrypoint.sh
    config/config.exs
    config/prod.exs
    config/runtime.exs
    lib/maraithon/runtime/coordination/authority.ex
    priv/repo/migrations/20260904190000_add_runtime_deployment_admission_gate.exs
    assets/css/app.css
    assets/js/app.js
    priv/static/offline.html
    priv/static/sw.js
    priv/static/favicon.ico
    priv/static/fonts/inter/InterVariable.woff2
    priv/static/fonts/inter/InterVariable-Italic.woff2
    priv/static/fonts/instrument-serif/InstrumentSerif-Regular.woff2
    priv/static/fonts/instrument-serif/InstrumentSerif-Italic.woff2
  )

  if ! upload_files="$(
    cd "${ROOT_DIR}" &&
      gcloud meta list-files-for-upload . |
        sed -e 's#^\./##' -e '/^$/d' |
        LC_ALL=C sort -u
  )"; then
    echo "Unable to enumerate the Cloud Build source upload" >&2
    return 1
  fi

  if ! ignored_files="$(
    git -c core.quotePath=false -C "${ROOT_DIR}" \
      ls-files --others --ignored --exclude-standard |
      sed -e 's#^\./##' -e '/^$/d' |
      LC_ALL=C sort -u
  )"; then
    echo "Unable to enumerate Git-ignored local files before Cloud Build" >&2
    return 1
  fi

  ignored_uploads="$(
    comm -12 \
      <(printf '%s\n' "${upload_files}") \
      <(printf '%s\n' "${ignored_files}")
  )"

  if [[ -n "${ignored_uploads}" ]]; then
    # Do not print names: ignored paths can themselves disclose credential or
    # incident content. The operator can compare the two read-only lists.
    echo "Refusing Cloud Build: its source upload contains Git-ignored local files" >&2
    return 1
  fi

  for required_path in "${required_paths[@]}"; do
    if [[ $'\n'"${upload_files}"$'\n' != *$'\n'"${required_path}"$'\n'* ]]; then
      echo "Refusing Cloud Build: required source path is absent from upload: ${required_path}" >&2
      return 1
    fi
  done

  echo "Cloud Build upload boundary verified: no ignored local files and all required sources present"
}

runtime_secret_specs=(
  "DATABASE_URL=maraithon-runtime-db-url"
  "SECRET_KEY_BASE=maraithon-secret-key-base"
  "API_BEARER_TOKEN=maraithon-api-bearer-token"
  "ADMIN_PASSWORD=maraithon-admin-password"
  "OPENROUTER_API_KEY=maraithon-openrouter-api-key"
  "CLOAK_KEY=maraithon-cloak-key"
  "DURABLE_PAYLOAD_BINDING_CURRENT_KEY=maraithon-payload-binding-key"
  "RELEASE_COOKIE=maraithon-release-cookie"
  "POSTMARK_SERVER_TOKEN=maraithon-postmark-server-token"
  "AUTH_EMAIL_FROM=maraithon-auth-email-from"
  "GOOGLE_CLIENT_ID=maraithon-google-client-id"
  "GOOGLE_CLIENT_SECRET=maraithon-google-client-secret"
  "GITHUB_CLIENT_ID=maraithon-github-client-id"
  "GITHUB_CLIENT_SECRET=maraithon-github-client-secret"
  "GITHUB_WEBHOOK_SECRET=maraithon-github-webhook-secret"
  "SLACK_CLIENT_ID=maraithon-slack-client-id"
  "SLACK_CLIENT_SECRET=maraithon-slack-client-secret"
  "SLACK_SIGNING_SECRET=maraithon-slack-signing-secret"
  "NOTAUI_CLIENT_ID=maraithon-notaui-client-id"
  "NOTAUI_CLIENT_SECRET=maraithon-notaui-client-secret"
)

runtime_secrets=""
migration_shared_secrets=""
runtime_database_secret_version=""
api_token_secret_version=""
secret_version_snapshot=""

for secret_spec in "${runtime_secret_specs[@]}"; do
  secret_env="${secret_spec%%=*}"
  secret_name="${secret_spec#*=}"
  secret_version="$(deployment_secret_version "${secret_name}")"
  secret_version_snapshot+="${secret_version_snapshot:+,}${secret_name}=${secret_version}"
  runtime_secrets+="${runtime_secrets:+,}${secret_env}=${secret_name}:${secret_version}"

  case "${secret_env}" in
    SECRET_KEY_BASE | API_BEARER_TOKEN | ADMIN_PASSWORD | OPENROUTER_API_KEY | CLOAK_KEY | DURABLE_PAYLOAD_BINDING_CURRENT_KEY | RELEASE_COOKIE)
      migration_shared_secrets+="${migration_shared_secrets:+,}${secret_env}=${secret_name}:${secret_version}"
      ;;
  esac

  case "${secret_env}" in
    DATABASE_URL)
      runtime_database_secret_version="${secret_version}"
      ;;
    API_BEARER_TOKEN)
      api_token_secret_version="${secret_version}"
      ;;
  esac
done

migrator_database_secret_version="$(deployment_secret_version maraithon-migrator-db-url)"
secret_version_snapshot+=",maraithon-migrator-db-url=${migrator_database_secret_version}"
migration_secrets="DATABASE_URL=maraithon-migrator-db-url:${migrator_database_secret_version},DIRECT_DATABASE_URL=maraithon-migrator-db-url:${migrator_database_secret_version},${migration_shared_secrets}"

if [[ -n "${resume_secret_versions}" &&
      "${resume_secret_versions}" != "${secret_version_snapshot}" ]]; then
  echo "Recovery secret snapshot is non-canonical or contains missing, reordered, or extra entries" >&2
  exit 64
fi

# A local deploy may run from a dirty worktree, so Git HEAD alone is not a
# controller identity. Bind the bytes that select, configure, and launch the
# rollout into the canonical manifest and therefore into both revision names.
deploy_script_hash="$(git -C "${ROOT_DIR}" hash-object scripts/monorepo/deploy)"
deploy_lib_hash="$(git -C "${ROOT_DIR}" hash-object scripts/monorepo/lib.sh)"
deploy_workflow_hash="$(git -C "${ROOT_DIR}" hash-object .github/workflows/deploy-gcp.yml)"
gcloudignore_hash="$(git -C "${ROOT_DIR}" hash-object .gcloudignore)"
gitignore_hash="$(git -C "${ROOT_DIR}" hash-object .gitignore)"
makefile_hash="$(git -C "${ROOT_DIR}" hash-object Makefile)"
config_hash="$(git -C "${ROOT_DIR}" hash-object config/config.exs)"
runtime_config_hash="$(git -C "${ROOT_DIR}" hash-object config/runtime.exs)"

deployment_config_manifest="$(
  jq -cnS \
    --arg schema "maraithon-split-deploy-v1" \
    --arg controller_revision "${revision}" \
    --arg project "${project}" \
    --arg region "${region}" \
    --arg web_service "${service}" \
    --arg runtime_service "${runtime_service}" \
    --arg runtime_service_account "${runtime_service_account}" \
    --arg web_service_account "${web_service_account}" \
    --arg deployer_service_account "${deployer_service_account}" \
    --arg connection "${connection}" \
    --arg protocol_revision "${protocol_revision}" \
    --arg gate_migration_version "${deployment_gate_migration_version}" \
    --arg deploy_script_hash "${deploy_script_hash}" \
    --arg deploy_lib_hash "${deploy_lib_hash}" \
    --arg deploy_workflow_hash "${deploy_workflow_hash}" \
    --arg gcloudignore_hash "${gcloudignore_hash}" \
    --arg gitignore_hash "${gitignore_hash}" \
    --arg makefile_hash "${makefile_hash}" \
    --arg config_hash "${config_hash}" \
    --arg runtime_config_hash "${runtime_config_hash}" \
    --arg maintenance_env "${maintenance_env}" \
    --arg runtime_env "${runtime_env}" \
    --arg web_env "${web_env}" \
    --arg migration_secrets "${migration_secrets}" \
    --arg runtime_secrets "${runtime_secrets}" \
    --arg secret_versions "${secret_version_snapshot}" '
      {
        schema: $schema,
        controller_revision: $controller_revision,
        controller_content: {
          deploy_script: $deploy_script_hash,
          deploy_lib: $deploy_lib_hash,
          workflow: $deploy_workflow_hash,
          gcloudignore: $gcloudignore_hash,
          gitignore: $gitignore_hash,
          makefile: $makefile_hash,
          config: $config_hash,
          runtime_config: $runtime_config_hash
        },
        topology: {
          project: $project,
          region: $region,
          web_service: $web_service,
          runtime_service: $runtime_service,
          runtime_service_account: $runtime_service_account,
          web_service_account: $web_service_account,
          deployer_service_account: $deployer_service_account,
          cloud_sql_connection: $connection
        },
        protocol: {
          exact_revision: $protocol_revision,
          gate_migration_version: $gate_migration_version
        },
        migration_job: {
          env: $maintenance_env,
          secrets: $migration_secrets,
          cpu: "1",
          memory: "2Gi",
          tasks: 1,
          parallelism: 1,
          timeout_seconds: 1800,
          max_retries: 0
        },
        runtime: {
          env: $runtime_env,
          secrets: $runtime_secrets,
          cpu: "2",
          memory: "2Gi",
          instances: 1,
          concurrency: 16,
          timeout_seconds: 3600,
          cpu_throttling: false,
          ingress: "all",
          invoker_iam: true
        },
        web: {
          env: $web_env,
          secrets: $runtime_secrets,
          cpu: "2",
          memory: "2Gi",
          min_instances: 1,
          max_instances: 5,
          concurrency: 40,
          timeout_seconds: 3600,
          cpu_throttling: false,
          ingress: "all",
          session_affinity: true,
          public_invoker: true
        },
        secret_versions: $secret_versions
      }
    '
)"

if [[ -n "${resume_config_manifest}" ]]; then
  if ! canonical_resume_config_manifest="$(jq -ceS . <<<"${resume_config_manifest}")"; then
    echo "MARAITHON_DEPLOYMENT_CONFIG_MANIFEST is not valid JSON" >&2
    exit 64
  fi

  if [[ "${canonical_resume_config_manifest}" != "${deployment_config_manifest}" ]]; then
    echo "The checked-out controller/configuration does not match the original deployment manifest" >&2
    exit 64
  fi
fi

deployment_config_hash="$(printf '%s' "${deployment_config_manifest}" | git -C "${ROOT_DIR}" hash-object --stdin)"
deployment_config_suffix="c${deployment_config_hash:0:12}"

if [[ "${revision_suffix_generated}" == "true" ]]; then
  revision_suffix="${revision_suffix}-${deployment_config_suffix}"
elif [[ "${revision_suffix}" != *"-${deployment_config_suffix}" ]]; then
  echo "Revision suffix does not bind the selected deployment configuration" >&2
  echo "Expected suffix ending: -${deployment_config_suffix}" >&2
  echo "For recovery, supply the original controller revision, secret snapshot, and configuration manifest" >&2
  exit 64
fi

expected_revision="${runtime_service}-${revision_suffix}"
expected_web_revision="${service}-${revision_suffix}"

if [[ ! "${revision_suffix}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ||
      ! "${expected_revision}" =~ ^[a-z]([a-z0-9-]*[a-z0-9])?$ ||
      ${#expected_revision} -gt 63 ||
      ! "${expected_web_revision}" =~ ^[a-z]([a-z0-9-]*[a-z0-9])?$ ||
      ${#expected_web_revision} -gt 63 ]]; then
  echo "Invalid Cloud Run revision suffix '${revision_suffix}' for services '${service}' and '${runtime_service}'" >&2
  echo "Both full revisions '${expected_web_revision}' and '${expected_revision}' must be lowercase DNS labels of at most 63 characters" >&2
  exit 64
fi

if [[ "${deployment_resume_phase}" == "retarget" ]]; then
  if [[ ! "${retarget_from_generation}" =~ ^[a-z]([a-z0-9-]*[a-z0-9])?$ ||
        ${#retarget_from_generation} -gt 63 ||
        "${retarget_from_generation}" != "${runtime_service}-"* ||
        ! "${retarget_from_image_digest}" =~ ^sha256:[0-9a-f]{64}$ ||
        ( "${retarget_from_phase}" != "deploying" &&
          "${retarget_from_phase}" != "activating" ) ]]; then
    echo "Retarget recovery requires a valid full previous generation, image digest, and previous phase (deploying or activating)" >&2
    exit 64
  fi

  if [[ "${retarget_from_generation}" == "${expected_revision}" ]]; then
    echo "Retarget recovery requires a fresh revision suffix" >&2
    exit 64
  fi

  if [[ "${retarget_confirmation}" != "PREDECESSOR_CONTROLLER_JOBS_AND_SERVICE_OPERATIONS_STOPPED" ]]; then
    echo "Retarget recovery requires MARAITHON_CONFIRM_RETARGET=PREDECESSOR_CONTROLLER_JOBS_AND_SERVICE_OPERATIONS_STOPPED" >&2
    echo "Confirm the predecessor deploy controller and deployment jobs are stopped and all Cloud Run service operations are settled" >&2
    exit 64
  fi
fi

stable_source_unavailable_recovery=false

if [[ -n "${unavailable_stable_generation}" ||
      -n "${unavailable_stable_image_digest}" ||
      -n "${unavailable_stable_confirmation}" ]]; then
  if [[ ( "${deployment_resume_phase}" != "new" &&
          "${deployment_resume_phase}" != "handoff" ) ||
        ! "${unavailable_stable_generation}" =~ ^${runtime_service}-[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ||
        ${#unavailable_stable_generation} -gt 63 ||
        ! "${unavailable_stable_image_digest}" =~ ^sha256:[0-9a-f]{64}$ ||
        "${unavailable_stable_confirmation}" != "STABLE_RUNTIME_SOURCE_UNAVAILABLE_AND_PREDECESSOR_STOPPED" ]]; then
    echo "Stable-source-unavailable recovery is only valid for a fresh new target or its exact handoff recovery and requires the prior runtime generation/digest plus confirmation" >&2
    exit 64
  fi

  stable_source_unavailable_recovery=true
fi

legacy_web_source_unavailable_recovery=false

if [[ -n "${unavailable_legacy_web_generation}" ||
      -n "${unavailable_legacy_web_image_digest}" ||
      -n "${unavailable_legacy_web_confirmation}" ]]; then
  if [[ "${deployment_resume_phase}" != "handoff" ||
        ! "${unavailable_legacy_web_generation}" =~ ^${service}-[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ||
        "${unavailable_legacy_web_generation}" == "${runtime_service}-"* ||
        ${#unavailable_legacy_web_generation} -gt 63 ||
        ! "${unavailable_legacy_web_image_digest}" =~ ^sha256:[0-9a-f]{64}$ ||
        "${unavailable_legacy_web_confirmation}" != "LEGACY_WEB_RUNTIME_SOURCE_UNAVAILABLE_AND_PREDECESSOR_STOPPED" ]]; then
    echo "Legacy web-runtime unavailable recovery is only valid for the one-time handoff recovery and requires the exact prior web revision/digest plus confirmation" >&2
    exit 64
  fi

  if [[ "${stable_source_unavailable_recovery}" == "true" ]]; then
    echo "Stable-runtime and legacy-web unavailable recovery inputs are mutually exclusive" >&2
    exit 64
  fi

  legacy_web_source_unavailable_recovery=true
fi

echo "Cloud Run runtime deployment generation: ${expected_revision}"
echo "Cloud Run web deployment revision: ${expected_web_revision}"
echo "Recovery controller revision: MARAITHON_DEPLOYMENT_CONTROLLER_REVISION=${revision}"
echo "Recovery secret snapshot: MARAITHON_DEPLOYMENT_SECRET_VERSIONS=${secret_version_snapshot}"
echo "Recovery config manifest: MARAITHON_DEPLOYMENT_CONFIG_MANIFEST=${deployment_config_manifest}"

# Drain the serving revision's coordination runtime before replacing it.
# Cloud Run only grants ~10s after SIGTERM, which is shorter than a drain under
# load; a stranded task keeps its partition draining until a human attests.
# Fail closed if the serving revision cannot prove a clean drain. Replacing an
# exact-runtime revision without that proof can strand leased work permanently.
if ! target_api_token="$(gcloud secrets versions access "${api_token_secret_version}" --secret maraithon-api-bearer-token --project "${project}" 2>/dev/null)"; then
  echo "Unable to read the API bearer token required for the runtime drain" >&2
  exit 1
fi

if [[ -z "${target_api_token}" ]]; then
  echo "The API bearer token required for the runtime drain is empty" >&2
  exit 1
fi

api_token="${target_api_token}"

cloud_run_service_exists=false
deployment_controller_lock="${service}-deployment-controller-lock"
deployment_controller_token=""
deployment_controller_lock_uid=""
deployment_controller_lock_owned=false
deployment_controller_lock_json=""
deployment_controller_lock_http_status=""

fetch_deployment_controller_lock() {
  local access_token
  local response
  local lock_url="https://run.googleapis.com/v2/projects/${project}/locations/${region}/jobs/${deployment_controller_lock}"

  if ! access_token="$(gcloud auth print-access-token --project "${project}")" ||
    [[ -z "${access_token}" ]]; then
    echo "Unable to mint an access token for the Cloud Run deployment-controller lock" >&2
    return 1
  fi

  if ! response="$(
    curl --silent --show-error \
      --header "Authorization: Bearer ${access_token}" \
      --write-out $'\n%{http_code}' \
      "${lock_url}"
  )"; then
    echo "Unable to query the Cloud Run deployment-controller lock" >&2
    return 1
  fi

  deployment_controller_lock_http_status="${response##*$'\n'}"
  deployment_controller_lock_json="${response%$'\n'*}"

  if [[ "${deployment_controller_lock_http_status}" != "200" &&
        "${deployment_controller_lock_http_status}" != "404" ]]; then
    echo "Cloud Run returned HTTP ${deployment_controller_lock_http_status} for the deployment-controller lock" >&2
    return 1
  fi
}

patch_deployment_controller_lock() {
  local expected_state="$1"
  local expected_token="$2"
  local expected_uid="$3"
  local desired_state="$4"
  local desired_token="$5"
  local access_token
  local request_body
  local response
  local response_body
  local response_status
  local lock_url="https://run.googleapis.com/v2/projects/${project}/locations/${region}/jobs/${deployment_controller_lock}"

  fetch_deployment_controller_lock || return 1

  if [[ "${deployment_controller_lock_http_status}" != "200" ]] ||
    ! jq -e \
      --arg project_id "${project}" \
      --arg project_number "${project_number}" \
      --arg region "${region}" \
      --arg job "${deployment_controller_lock}" \
      --arg state "${expected_state}" \
      --arg token "${expected_token}" \
      --arg uid "${expected_uid}" '
        (.name == "projects/\($project_id)/locations/\($region)/jobs/\($job)" or
         .name == "projects/\($project_number)/locations/\($region)/jobs/\($job)") and
        .uid == $uid and
        (.reconciling // false) == false and
        .observedGeneration == .generation and
        .terminalCondition.state == "CONDITION_SUCCEEDED" and
        .labels["maraithon-controller-lock"] == "true" and
        .labels["maraithon-controller-state"] == $state and
        (if $token == "" then
           (.labels | has("maraithon-controller-token") | not)
         else
           .labels["maraithon-controller-token"] == $token
         end) and
        (.etag | type == "string" and length > 0)
      ' >/dev/null 2>&1 <<<"${deployment_controller_lock_json}"; then
    echo "The deployment-controller lock changed; refusing its compare-and-swap update" >&2
    return 1
  fi

  if ! request_body="$(
    jq -ce \
      --arg state "${desired_state}" \
      --arg token "${desired_token}" '
        {
          name,
          labels: (
            .labels + {"maraithon-controller-state": $state} |
            if $token == "" then del(."maraithon-controller-token")
            else . + {"maraithon-controller-token": $token}
            end
          ),
          annotations,
          launchStage,
          binaryAuthorization,
          template,
          etag
        } |
        with_entries(select(.value != null))
      ' <<<"${deployment_controller_lock_json}"
  )"; then
    echo "Unable to construct the exact-etag controller-lock update" >&2
    return 1
  fi

  # Cloud Run v2 Jobs.Patch exposes no updateMask parameter. Preserve the
  # current full mutable Job configuration and change only lock labels; the
  # body etag is the server-side compare-and-swap precondition.

  if ! access_token="$(gcloud auth print-access-token --project "${project}")" ||
    [[ -z "${access_token}" ]]; then
    echo "Unable to mint an access token to update the Cloud Run deployment-controller lock" >&2
    return 1
  fi

  if ! response="$(
    curl --silent --show-error \
      --request PATCH \
      --header "Authorization: Bearer ${access_token}" \
      --header 'Content-Type: application/json' \
      --data "${request_body}" \
      --write-out $'\n%{http_code}' \
      "${lock_url}"
  )"; then
    echo "The exact-etag compare-and-swap update of the controller lock failed" >&2
    return 1
  fi

  response_status="${response##*$'\n'}"
  response_body="${response%$'\n'*}"

  if [[ "${response_status}" != "200" ]] ||
    ! jq -e '.name | type == "string" and length > 0' \
      >/dev/null 2>&1 <<<"${response_body}"; then
    echo "Cloud Run rejected the exact-etag controller-lock compare-and-swap (HTTP ${response_status})" >&2
    return 1
  fi

  for _attempt in $(seq 1 24); do
    fetch_deployment_controller_lock || return 1

    if [[ "${deployment_controller_lock_http_status}" == "200" ]] &&
      jq -e \
        --arg state "${desired_state}" \
        --arg token "${desired_token}" \
        --arg uid "${expected_uid}" '
          .uid == $uid and
          (.reconciling // false) == false and
          .observedGeneration == .generation and
          .terminalCondition.state == "CONDITION_SUCCEEDED" and
          .labels["maraithon-controller-lock"] == "true" and
          .labels["maraithon-controller-state"] == $state and
          (if $token == "" then
             (.labels | has("maraithon-controller-token") | not)
           else
             .labels["maraithon-controller-token"] == $token
           end)
        ' >/dev/null 2>&1 <<<"${deployment_controller_lock_json}"; then
      return 0
    fi

    sleep 2
  done

  echo "Timed out waiting for the deployment-controller lock compare-and-swap" >&2
  return 1
}

verify_deployment_controller_lock() {
  if [[ "${deployment_controller_lock_owned}" != "true" ||
        ! "${deployment_controller_token}" =~ ^[0-9a-f]{40}$ ||
        -z "${deployment_controller_lock_uid}" ]]; then
    echo "This process has no verified deployment-controller lock" >&2
    return 1
  fi

  fetch_deployment_controller_lock || return 1

  if [[ "${deployment_controller_lock_http_status}" != "200" ]] ||
    ! jq -e \
      --arg project_id "${project}" \
      --arg project_number "${project_number}" \
      --arg region "${region}" \
      --arg job "${deployment_controller_lock}" \
      --arg token "${deployment_controller_token}" \
      --arg uid "${deployment_controller_lock_uid}" '
        (.name == "projects/\($project_id)/locations/\($region)/jobs/\($job)" or
         .name == "projects/\($project_number)/locations/\($region)/jobs/\($job)") and
        .uid == $uid and
        (.reconciling // false) == false and
        .observedGeneration == .generation and
        .terminalCondition.state == "CONDITION_SUCCEEDED" and
        .labels["maraithon-controller-lock"] == "true" and
        .labels["maraithon-controller-state"] == "held" and
        .labels["maraithon-controller-token"] == $token and
        (.etag | type == "string" and length > 0)
      ' >/dev/null 2>&1 <<<"${deployment_controller_lock_json}"; then
    echo "This process no longer owns the exact Cloud Run deployment-controller lock" >&2
    return 1
  fi
}

acquire_deployment_controller_lock() {
  local existing_token
  local existing_uid
  local token_seed

  fetch_deployment_controller_lock || return 1

  token_seed="${expected_revision}-${image_digest}-${revision}-$(date -u +%Y%m%d%H%M%S%N)-$$-${RANDOM}"
  deployment_controller_token="$(printf '%s' "${token_seed}" | git -C "${ROOT_DIR}" hash-object --stdin)"
  echo "Crash-sticky controller token: MARAITHON_DEPLOYMENT_LOCK_PREDECESSOR_TOKEN=${deployment_controller_token}"

  if [[ "${deployment_controller_lock_http_status}" == "200" ]]; then
    if ! jq -e '
      .labels["maraithon-controller-lock"] == "true" and
      ((.labels["maraithon-controller-state"] == "free" and
        (.labels | has("maraithon-controller-token") | not)) or
       (.labels["maraithon-controller-state"] == "held" and
        (.labels["maraithon-controller-token"] | type == "string" and test("^[0-9a-f]{40}$")))) and
      (.uid | type == "string" and length > 0) and
      (.etag | type == "string" and length > 0) and
      (.reconciling // false) == false and
      .observedGeneration == .generation and
      .terminalCondition.state == "CONDITION_SUCCEEDED"
    ' >/dev/null 2>&1 <<<"${deployment_controller_lock_json}"; then
      echo "The fixed Cloud Run controller-lock resource is malformed or has unknown state" >&2
      return 1
    fi

    existing_uid="$(jq -er '.uid | select(type == "string" and length > 0)' <<<"${deployment_controller_lock_json}")"

    if jq -e '
      .labels["maraithon-controller-lock"] == "true" and
      .labels["maraithon-controller-state"] == "free" and
      (.labels | has("maraithon-controller-token") | not)
    ' >/dev/null 2>&1 <<<"${deployment_controller_lock_json}"; then
      if [[ -n "${predecessor_controller_token}" || -n "${lock_recovery_confirmation}" ]]; then
        echo "Lock-recovery credentials were supplied, but the persistent controller lock is free" >&2
        return 1
      fi

      patch_deployment_controller_lock \
        free "" "${existing_uid}" held "${deployment_controller_token}" || return 1
      deployment_controller_lock_uid="${existing_uid}"
      deployment_controller_lock_owned=true
      verify_deployment_controller_lock
      return
    fi

    if [[ ! "${predecessor_controller_token}" =~ ^[0-9a-f]{40}$ ||
          "${lock_recovery_confirmation}" != "PREDECESSOR_CONTROLLER_STOPPED_AND_CLOUD_RUN_OPERATIONS_SETTLED" ]]; then
      echo "A crash-sticky production deployment-controller lock is held" >&2
      echo "Only after proving the predecessor controller is stopped and all Cloud Run operations have settled, recover with its exact printed token and confirmation phrase" >&2
      return 1
    fi

    if ! existing_token="$(
      jq -er '
        select(
          .labels["maraithon-controller-lock"] == "true" and
          .labels["maraithon-controller-state"] == "held"
        ) |
        .labels["maraithon-controller-token"] |
        select(type == "string")
      ' <<<"${deployment_controller_lock_json}"
    )" || [[ "${existing_token}" != "${predecessor_controller_token}" ]]; then
      echo "The supplied predecessor token does not exactly match the sticky controller lock" >&2
      return 1
    fi

    echo "Atomically replacing the exact predecessor token after explicit stopped/settled confirmation"
    patch_deployment_controller_lock \
      held "${existing_token}" "${existing_uid}" held "${deployment_controller_token}" || return 1
    deployment_controller_lock_uid="${existing_uid}"
    deployment_controller_lock_owned=true
    verify_deployment_controller_lock
    return
  elif [[ -n "${predecessor_controller_token}" || -n "${lock_recovery_confirmation}" ]]; then
    echo "Lock-recovery credentials were supplied, but the predecessor lock is absent" >&2
    echo "Refusing because absence cannot prove that the predecessor controller has stopped" >&2
    return 1
  fi

  # `jobs create` is an atomic create-if-absent operation. Never use deploy or
  # update here: an overlapping controller must fail instead of replacing the
  # token that fences every database-gate and traffic mutation below.
  if ! gcloud run jobs create "${deployment_controller_lock}" \
    --project "${project}" \
    --region "${region}" \
    --image "${pinned_image}" \
    --service-account "${runtime_service_account}" \
    --labels "maraithon-controller-lock=true,maraithon-controller-state=held,maraithon-controller-token=${deployment_controller_token}" \
    --command /bin/sh \
    --args=-c,true \
    --tasks 1 \
    --parallelism 1 \
    --task-timeout 1m \
    --max-retries 0 \
    --quiet; then
    echo "Atomic acquisition of the deployment-controller lock failed; another controller may own it" >&2
    return 1
  fi

  for _attempt in $(seq 1 24); do
    fetch_deployment_controller_lock || return 1

    if [[ "${deployment_controller_lock_http_status}" == "200" ]] &&
      jq -e --arg token "${deployment_controller_token}" '
        (.reconciling // false) == false and
        .observedGeneration == .generation and
        .terminalCondition.state == "CONDITION_SUCCEEDED" and
        .labels["maraithon-controller-lock"] == "true" and
        .labels["maraithon-controller-state"] == "held" and
        .labels["maraithon-controller-token"] == $token
      ' >/dev/null 2>&1 <<<"${deployment_controller_lock_json}"; then
      break
    fi

    sleep 2
  done

  if [[ "${deployment_controller_lock_http_status}" != "200" ]] ||
    ! deployment_controller_lock_uid="$(
      jq -er \
        --arg token "${deployment_controller_token}" '
          select(
            (.reconciling // false) == false and
            .observedGeneration == .generation and
            .terminalCondition.state == "CONDITION_SUCCEEDED" and
            .labels["maraithon-controller-lock"] == "true" and
            .labels["maraithon-controller-state"] == "held" and
            .labels["maraithon-controller-token"] == $token and
            (.etag | type == "string" and length > 0)
          ) |
          .uid | select(type == "string" and length > 0)
        ' <<<"${deployment_controller_lock_json}"
    )"; then
    echo "Cloud Run did not return the newly acquired controller lock identity" >&2
    return 1
  fi

  deployment_controller_lock_owned=true
  verify_deployment_controller_lock
}

release_deployment_controller_lock() {
  verify_deployment_controller_lock || return 1
  patch_deployment_controller_lock \
    held "${deployment_controller_token}" "${deployment_controller_lock_uid}" free "" || return 1
  deployment_controller_lock_owned=false
  echo "Released exact persistent deployment-controller lock ${deployment_controller_lock}"
}

cloud_run_service_not_found() {
  local output="$1"
  local service_name="$2"

  [[ "${output}" == *"Cannot find service [${service_name}]"* ||
    "${output}" == *"Service [${service_name}] could not be found."* ||
    "${output}" == *"Service '${service_name}' not found"* ||
    "${output}" == *"Resource '${service_name}' was not found"* ]]
}

probe_cloud_run_service() {
  local service_name="$1"
  local output

  if output="$(
    gcloud --verbosity=error run services describe "${service_name}" \
      --project "${project}" \
      --region "${region}" \
      --format='value(metadata.name)' 2>&1
  )"; then
    if [[ "${output}" != "${service_name}" ]]; then
      echo "Cloud Run returned an unexpected service identity: ${output}" >&2
      return 1
    fi

    cloud_run_service_exists=true
  elif cloud_run_service_not_found "${output}" "${service_name}"; then
    cloud_run_service_exists=false
  else
    echo "Unable to determine whether Cloud Run service ${service_name} exists" >&2
    echo "${output}" >&2
    return 1
  fi
}

cloud_run_service_url() {
  local service_name="$1"
  local url

  if ! url="$(
    gcloud run services describe "${service_name}" \
      --project "${project}" \
      --region "${region}" \
      --format='value(status.url)'
  )" || [[ ! "${url}" =~ ^https://[a-z0-9.-]+\.run\.app$ ]]; then
    echo "Unable to resolve the authoritative Cloud Run URL for ${service_name}" >&2
    return 1
  fi

  printf '%s\n' "${url}"
}

set_api_token_from_serving_revision() {
  local service_name="$1"
  local service_json
  local serving_revision
  local revision_json
  local secret_ref
  local source_secret_name
  local source_secret_version

  service_json="$(
    gcloud run services describe "${service_name}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"

  if ! serving_revision="$(
    jq -er '
      [.status.traffic[]? | select((.percent // 0) > 0)] as $active |
      select(($active | length) == 1 and $active[0].percent == 100) |
      $active[0].revisionName | select(type == "string" and length > 0)
    ' <<<"${service_json}"
  )"; then
    echo "Runtime source ${service_name} does not have one exact 100% serving revision" >&2
    return 1
  fi

  revision_json="$(
    gcloud run revisions describe "${serving_revision}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"

  if ! secret_ref="$(
    jq -er '
      [.spec.containers[0].env[]? |
        select(.name == "API_BEARER_TOKEN") |
        .valueFrom.secretKeyRef] |
      select(length == 1) | .[0] |
      [.name, .key] | @tsv
    ' <<<"${revision_json}"
  )"; then
    echo "Serving revision ${serving_revision} does not have one Secret Manager API bearer binding" >&2
    return 1
  fi

  IFS=$'\t' read -r source_secret_name source_secret_version <<<"${secret_ref}"

  if [[ "${source_secret_name}" != "maraithon-api-bearer-token" ||
        ("${source_secret_version}" != "latest" &&
         ! "${source_secret_version}" =~ ^[1-9][0-9]*$) ]]; then
    echo "Serving revision ${serving_revision} has an invalid API bearer secret identity" >&2
    return 1
  fi

  if ! api_token="$(
    gcloud secrets versions access "${source_secret_version}" \
      --secret "${source_secret_name}" \
      --project "${project}" 2>/dev/null
  )" || [[ -z "${api_token}" ]]; then
    echo "Unable to read the API bearer version used by ${serving_revision}" >&2
    return 1
  fi

  echo "Runtime source credential revision: ${serving_revision}"
}

runtime_control_url=""
runtime_identity_token=""

configure_runtime_control() {
  local service_name="$1"

  runtime_control_url="$(cloud_run_service_url "${service_name}")"
  runtime_identity_token=""

  if [[ "${service_name}" == "${runtime_service}" ]]; then
    if ! runtime_identity_token="$(
      gcloud auth print-identity-token \
        --impersonate-service-account "${deployer_service_account}" \
        --audiences "${runtime_control_url}" \
        --include-email \
        --project "${project}"
    )" || [[ -z "${runtime_identity_token}" ]]; then
      echo "Unable to mint the Google-signed ID token required to invoke ${runtime_service}" >&2
      return 1
    fi
  fi
}

runtime_request() {
  local method="$1"
  local path="$2"
  local headers=(-H "Authorization: Bearer ${api_token}")

  if [[ -n "${runtime_identity_token}" ]]; then
    # Cloud Run consumes this header for IAM while the application consumes
    # Authorization for its own API bearer-token check.
    headers+=(-H "X-Serverless-Authorization: Bearer ${runtime_identity_token}")
  fi

  curl --silent --show-error --fail --max-time 15 \
    -X "${method}" \
    "${headers[@]}" \
    "${runtime_control_url}${path}"
}

request_runtime_drain() {
  # Drain mutates the exact runtime. Fence it at the call boundary so a
  # controller replaced by the lock CAS cannot drain the current owner after
  # doing otherwise read-only source discovery or token setup.
  verify_deployment_controller_lock || return 1
  runtime_request POST /api/v1/runtime/drain
}

runtime_status() {
  runtime_request GET /api/v1/runtime/status 2>/dev/null || true
}

runtime_status_matches_strong_drain() {
  jq -e '
    type == "object" and
    .phase == "draining" and
    .node_fenced == true and
    .admitting_nodes == 0 and
    .admitting_partitions == 0 and
    .open_tasks == 0 and
    .unproven_tasks == 0 and
    .local_agent_leases == 0 and
    .agent_leases == 0
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_matches_dormant_global_drain() {
  jq -e '
    type == "object" and
    .phase == "dormant" and
    has("node_incarnation_id") and
    .node_incarnation_id == null and
    .node_fenced == false and
    .admitting_nodes == 0 and
    .admitting_partitions == 0 and
    .owned_partitions == 0 and
    .open_tasks == 0 and
    .unproven_tasks == 0 and
    .local_agent_leases == 0 and
    .agent_leases == 0
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_matches_legacy_drain() {
  jq -e '
    type == "object" and
    (has("admitting_partitions") | not) and
    .phase == "draining" and
    .open_tasks == 0 and
    .unproven_tasks == 0 and
    .local_agent_leases == 0
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_matches_legacy_dormant() {
  jq -e '
    type == "object" and
    (has("admitting_partitions") | not) and
    .phase == "dormant" and
    .node_incarnation_id == null and
    .open_tasks == 0 and
    .unproven_tasks == 0 and
    .local_agent_leases == 0
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_has_legacy_contract() {
  jq -e '
    type == "object" and
    (.phase | type) == "string" and
    (has("admitting_partitions") | not)
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_matches_dormant_generation() {
  jq -e --arg generation "$2" --arg digest "$3" '
    type == "object" and
    .process_role == "runtime" and
    .deployment_generation == $generation and
    .phase == "dormant" and
    .node_incarnation_id == null and
    .node_fenced == false and
    .admitting_nodes == 0 and
    .admitting_partitions == 0 and
    .owned_partitions == 0 and
    .open_tasks == 0 and
    .unproven_tasks == 0 and
    .local_agent_leases == 0 and
    .agent_leases == 0 and
    .deployment_gate.state == "deploying" and
    .deployment_gate.target_generation == $generation and
    .deployment_gate.image_digest == $digest
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_matches_ready_activating_generation() {
  jq -e --arg generation "$2" --arg digest "$3" '
    type == "object" and
    .process_role == "runtime" and
    .deployment_generation == $generation and
    .phase == "ready" and
    .node_fenced == false and
    .admitting_nodes == 1 and
    .unready_partitions == 0 and
    .deployment_gate.state == "activating" and
    .deployment_gate.target_generation == $generation and
    .deployment_gate.image_digest == $digest
  ' >/dev/null 2>&1 <<<"$1"
}

runtime_status_matches_ready_stable_generation() {
  jq -e --arg generation "$2" --arg digest "$3" '
    type == "object" and
    .process_role == "runtime" and
    .deployment_generation == $generation and
    .phase == "ready" and
    .node_fenced == false and
    .admitting_nodes == 1 and
    .unready_partitions == 0 and
    .deployment_gate.state == "stable" and
    .deployment_gate.target_generation == $generation and
    .deployment_gate.stable_generation == $generation and
    .deployment_gate.image_digest == $digest
  ' >/dev/null 2>&1 <<<"$1"
}

verify_deployment_job() {
  local job_json

  if ! job_json="$(
    gcloud run jobs describe "${deployment_job}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"; then
    echo "Unable to describe deployment job ${deployment_job}" >&2
    return 1
  fi

  if ! jq -e \
    --arg job "${deployment_job}" \
    --arg image "${pinned_image}" \
    --arg service_account "${runtime_service_account}" \
    --arg cloud_sql_connection "${connection}" \
    --arg protocol_revision "${protocol_revision}" \
    --arg migrator_database_secret_version "${migrator_database_secret_version}" \
    --arg api_token_secret_version "${api_token_secret_version}" \
    --arg secret_bindings "${migration_secrets}" \
    --arg expected_env "${maintenance_env}" \
    --arg default_expression 'raise("deployment job requires an explicit execution override")' '
    def task_spec: .spec.template.spec.template.spec;
    def container: task_spec.containers[0];
    def env_value($name):
      [container.env[]? | select(.name == $name) | .value] | first;
    def secret_ref($name):
      [container.env[]? | select(.name == $name) | .valueFrom.secretKeyRef] | first;
    def expected_secret_refs($bindings):
      reduce ($bindings | split(",")[]) as $binding
        ({};
         ($binding |
           capture("^(?<env>[A-Z0-9_]+)=(?<name>[a-z0-9-]+):(?<key>[1-9][0-9]*)$")) as $parsed |
         .[$parsed.env] = {name: $parsed.name, key: $parsed.key});
    def actual_secret_refs:
      reduce (container.env[]? | select(.valueFrom.secretKeyRef? != null)) as $env
        ({}; .[$env.name] = $env.valueFrom.secretKeyRef);
    def expected_plain_env($bindings):
      reduce ($bindings | split(",")[]) as $binding
        ({};
         ($binding | capture("^(?<name>[A-Z0-9_]+)=(?<value>.*)$")) as $parsed |
         .[$parsed.name] = $parsed.value);
    def actual_plain_env:
      reduce (container.env[]? | select(has("value"))) as $env
        ({}; .[$env.name] = $env.value);

    type == "object" and
    .metadata.name == $job and
    .metadata.labels["maraithon-deployment-job"] == "true" and
    .spec.template.metadata.annotations["run.googleapis.com/cloudsql-instances"] == $cloud_sql_connection and
    .spec.template.spec.parallelism == 1 and
    .spec.template.spec.taskCount == 1 and
    task_spec.serviceAccountName == $service_account and
    task_spec.maxRetries == 0 and
    (task_spec.timeoutSeconds | tostring) == "1800" and
    (task_spec.containers | type == "array" and length == 1) and
    ([container.env[]?.name] | length == (unique | length)) and
    container.image == $image and
    container.command == ["/app/bin/maraithon"] and
    container.args == ["eval", $default_expression] and
    (container.resources.limits.cpu | tostring) == "1" and
    container.resources.limits.memory == "2Gi" and
    env_value("MARAITHON_PROCESS_ROLE") == "maintenance" and
    env_value("POOL_SIZE") == "2" and
    env_value("EXACT_AGENT_RUNTIME_ENABLED") == "true" and
    env_value("MULTINODE_COORDINATION_ENABLED") == "true" and
    env_value("DATABASE_POOL_MODE") == "session" and
    env_value("GIT_SHA") == $protocol_revision and
    actual_plain_env == expected_plain_env($expected_env) and
    secret_ref("DATABASE_URL").name == "maraithon-migrator-db-url" and
    secret_ref("DATABASE_URL").key == $migrator_database_secret_version and
    secret_ref("DIRECT_DATABASE_URL").name == "maraithon-migrator-db-url" and
    secret_ref("DIRECT_DATABASE_URL").key == $migrator_database_secret_version and
    secret_ref("API_BEARER_TOKEN").name == "maraithon-api-bearer-token" and
    secret_ref("API_BEARER_TOKEN").key == $api_token_secret_version and
    actual_secret_refs == expected_secret_refs($secret_bindings) and
    ([container.env[]? | .valueFrom.secretKeyRef? | select(.)] |
      all(.[]; (.key | type) == "string" and (.key | test("^[1-9][0-9]*$"))))
  ' >/dev/null 2>&1 <<<"${job_json}"; then
    echo "Deployment job ${deployment_job} failed its exact identity, database, role, image, command, or execution-limit proof" >&2
    return 1
  fi
}

execute_deployment_job() {
  verify_deployment_controller_lock || return 1

  if gcloud run jobs execute "${deployment_job}" \
    --project "${project}" \
    --region "${region}" \
    "$@" \
    --wait \
    --quiet; then
    :
  else
    return 1
  fi
}

run_gate_bootstrap_migrations() {
  verify_deployment_job || return 1

  execute_deployment_job \
    --args="^@^eval@Maraithon.Release.migrate_to(${deployment_gate_migration_version})" \
    --update-env-vars "POOL_SIZE=2"
}

run_full_migrations() {
  verify_deployment_job || return 1

  execute_deployment_job \
    --args="^@^eval@Maraithon.Release.migrate" \
    --update-env-vars "POOL_SIZE=2"
}

global_quiescence_db_preflight() {
  local expression

  expression="$(cat <<'ELIXIR'
Application.load(:maraithon)
sql = """
SELECT
  NOT EXISTS (
    SELECT 1 FROM public.runtime_node_incarnations
    WHERE state IN ('joining', 'ready')
      AND lease_expires_at > timezone('UTC', clock_timestamp())
  ),
  NOT EXISTS (
    SELECT 1 FROM public.runtime_leader_authorities
    WHERE state IN ('preparing', 'ready')
      AND lease_expires_at > timezone('UTC', clock_timestamp())
  ),
  NOT EXISTS (
    SELECT 1 FROM public.runtime_partitions
    WHERE state IN ('preparing', 'ready')
      AND (
        lease_expires_at IS NULL OR
        lease_expires_at > timezone('UTC', clock_timestamp())
      )
  ),
  NOT EXISTS (
    SELECT 1 FROM public.runtime_task_assignments
    WHERE state IN ('reserved', 'running', 'termination_requested', 'termination_proven')
  ),
  NOT EXISTS (SELECT 1 FROM public.agent_runtime_leases)
"""

{:ok, checks, _apps} =
  Ecto.Migrator.with_repo(Maraithon.Repo, fn repo ->
    repo.query!(sql, []).rows |> hd()
  end)

keys = ~w(no_live_nodes no_live_leader no_admitting_partitions no_unresolved_tasks no_agent_leases)
IO.puts("GLOBAL_RUNTIME_QUIESCENCE=" <> Jason.encode!(Map.new(Enum.zip(keys, checks))))
unless Enum.all?(checks, &(&1 == true)), do: raise("global runtime is not quiescent")
ELIXIR
)"

  verify_deployment_job || return 1

  execute_deployment_job \
    --args="^@^eval@${expression}" \
    --update-env-vars "POOL_SIZE=2"
}

