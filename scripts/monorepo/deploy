deploy_runtime_candidate() {
  local service_preexisting="$1"
  local traffic_args=()

  verify_deployment_controller_lock || return 1

  if [[ "${service_preexisting}" == "true" ]]; then
    traffic_args+=(--no-traffic)
  fi

  if ! gcloud run deploy "${runtime_service}" \
    --project "${project}" \
    --region "${region}" \
    --image "${pinned_image}" \
    --revision-suffix "${revision_suffix}" \
    --service-account "${runtime_service_account}" \
    --set-cloudsql-instances "${connection}" \
    --set-env-vars "${runtime_env}" \
    --set-secrets "${runtime_secrets}" \
    --no-allow-unauthenticated \
    --invoker-iam-check \
    --ingress all \
    --execution-environment gen2 \
    --port 8080 \
    --cpu 2 \
    --memory 2Gi \
    --scaling 1 \
    --concurrency 16 \
    --timeout 3600 \
    --no-cpu-throttling \
    --no-session-affinity \
    --startup-probe 'httpGet.path=/health,initialDelaySeconds=5,timeoutSeconds=5,periodSeconds=5,failureThreshold=24' \
    --labels 'maraithon-process-role=runtime' \
    "${traffic_args[@]}" \
    --quiet; then
    print_target_diagnostics
    return 1
  fi

  grant_deployer_runtime_invocation || return 1
  verify_runtime_service_private || return 1
}

deploy_web_candidate() {
  verify_deployment_controller_lock || return 1

  if ! gcloud run deploy "${service}" \
    --project "${project}" \
    --region "${region}" \
    --image "${pinned_image}" \
    --revision-suffix "${revision_suffix}" \
    --service-account "${web_service_account}" \
    --set-cloudsql-instances "${connection}" \
    --set-env-vars "${web_env}" \
    --set-secrets "${runtime_secrets}" \
    --allow-unauthenticated \
    --invoker-iam-check \
    --ingress all \
    --execution-environment gen2 \
    --port 8080 \
    --cpu 2 \
    --memory 2Gi \
    --scaling auto \
    --min 1 \
    --max 5 \
    --concurrency 40 \
    --timeout 3600 \
    --no-cpu-throttling \
    --session-affinity \
    --startup-probe 'httpGet.path=/health,initialDelaySeconds=5,timeoutSeconds=5,periodSeconds=5,failureThreshold=24' \
    --labels 'maraithon-process-role=web' \
    --no-traffic \
    --quiet; then
    print_target_web_diagnostics
    return 1
  fi
}

assert_target_gate_phase() {
  case "${deployment_resume_phase}" in
    activating)
      deployment_gate_transition assert_activating
      ;;

    stable)
      deployment_gate_transition assert_stable
      ;;

    new | handoff | deploying | retarget)
      deployment_gate_transition assert_deploying
      ;;
  esac
}

deployment_job=""

case "${deployment_resume_phase}" in
  handoff | deploying | activating | retarget)
    deployment_gate_may_be_closed=true
    ;;

  new | stable)
    deployment_gate_may_be_closed=false
    ;;
esac

cleanup_deployment() {
  local exit_status="$?"
  trap - EXIT INT TERM

  if [[ "${exit_status}" -ne 0 && "${deployment_gate_may_be_closed}" == "true" ]]; then
    echo "Deployment stopped after the durable gate may have closed; no automatic abort or rejoin was attempted" >&2
    echo "Inspect the durable phase, then use an exact handoff, deploying, activating, retarget, or stable recovery with the printed identities" >&2

    if [[ "${deployment_resume_phase}" == "new" ||
          "${deployment_resume_phase}" == "handoff" ]]; then
      echo "If the durable phase is still handoff, abandonment requires the incident-only abort primitive with the exact target/digest after proving no out-of-band migration execution was launched" >&2
    fi
  fi

  if [[ "${exit_status}" -ne 0 && "${deployment_controller_lock_owned}" == "true" ]]; then
    echo "The crash-sticky controller lock was intentionally retained" >&2
    echo "Recovery requires MARAITHON_DEPLOYMENT_LOCK_PREDECESSOR_TOKEN=${deployment_controller_token}" >&2
    echo "Remove/reacquire it only with explicit predecessor-stopped and Cloud-Run-operations-settled confirmation" >&2
  fi

  exit "${exit_status}"
}

trap cleanup_deployment EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Cloud Build keeps Docker tooling and registry credentials out of the deployer.
# The regional public pool can queue indefinitely (2026-08-28: 60+ minutes in
# us-central1 while global started at once). Build on the global pool; the
# image still lands in the regional Artifact Registry.
build_region="${MARAITHON_GCP_BUILD_REGION:-global}"

if [[ "${deployment_resume_phase}" == "new" ]]; then
  verify_cloud_build_upload_boundary

  build_tag_nonce="$(
    printf '%s' \
      "${expected_revision}-${revision}-$(date -u +%Y%m%d%H%M%S)-$$-${RANDOM}" |
      git -C "${ROOT_DIR}" hash-object --stdin
  )"
  image_tag="${image_repository}:deploy-${revision:0:12}-${build_tag_nonce:0:20}"

  run_in "${ROOT_DIR}" gcloud builds submit \
    --project "${project}" \
    --region "${build_region}" \
    --tag "${image_tag}" \
    --timeout 1800s \
    --quiet .

  image_digest="$(
    gcloud artifacts docker images describe "${image_tag}" \
      --project "${project}" \
      --format='value(image_summary.digest)'
  )"

  if [[ ! "${image_digest}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    echo "Artifact Registry did not resolve ${image_tag} to one immutable sha256 digest" >&2
    echo "Resolved value: ${image_digest:-empty}" >&2
    exit 1
  fi
else
  image_digest="${resume_image_digest}"
  echo "Resuming with the previously gated image digest; Cloud Build is intentionally skipped"
fi

pinned_image="${image_repository}@${image_digest}"

if [[ -n "${GITHUB_RUN_ID:-}" ]]; then
  deployment_job_run_attempt="${GITHUB_RUN_ATTEMPT:-1}"

  if [[ ! "${GITHUB_RUN_ID}" =~ ^[0-9]+$ ||
        ! "${deployment_job_run_attempt}" =~ ^[0-9]+$ ]]; then
    echo "Unable to derive a deployment job identity from the GitHub run metadata" >&2
    exit 64
  fi

  deployment_job_invocation="github:${GITHUB_RUN_ID}:${deployment_job_run_attempt}"
else
  deployment_job_nonce="$(
    printf '%s' "${expected_revision}-${image_digest}-$(date -u +%Y%m%d%H%M%S%N)-$$-${RANDOM}" |
      git -C "${ROOT_DIR}" hash-object --stdin
  )"
  deployment_job_invocation="local:${deployment_job_nonce}"
fi

deployment_job_key="$(
  printf 'target_generation=%s\nimage_digest=%s\ninvocation=%s\n' \
    "${expected_revision}" "${image_digest}" "${deployment_job_invocation}" |
    git -C "${ROOT_DIR}" hash-object --stdin
)"
deployment_job="migrate-${deployment_job_key}"

if [[ ! "${deployment_job_key}" =~ ^[0-9a-f]{40}$ ||
      ! "${deployment_job}" =~ ^[a-z]([a-z0-9-]*[a-z0-9])?$ ||
      ${#deployment_job} -gt 49 ]]; then
  echo "Unable to derive a valid per-deployment Cloud Run job name" >&2
  echo "Derived name: ${deployment_job}" >&2
  exit 1
fi

echo "Pinned deployment image: ${pinned_image}"
echo "Pinned deployment job: ${deployment_job}"
echo "Recovery identity: MARAITHON_GCP_REVISION_SUFFIX=${revision_suffix} MARAITHON_DEPLOYMENT_IMAGE_DIGEST=${image_digest}"

acquire_deployment_controller_lock

# Gmail requires the watch topic to live in the Google OAuth client's project.
# Provision it only while this controller owns the deployment mutex. The
# default cross-project topic is pre-provisioned by its owning project and is
# intentionally left unchanged by Maraithon deploys.
verify_deployment_controller_lock

if [[ "${gmail_pubsub_project}" == "${project}" ]]; then
  run_in "${ROOT_DIR}" gcloud builds submit   --project "${project}"   --region "${region}"   --no-source   --config "scripts/monorepo/cloudbuild-provision-gmail.yaml"   --substitutions "_TOPIC_ID=${gmail_topic_id},_SUBSCRIPTION_ID=${gmail_subscription_id},_PUSH_ENDPOINT=${gmail_push_endpoint}"   --timeout 300s   --quiet
else
  echo "Using pre-provisioned external Gmail Pub/Sub topic: ${gmail_topic}"
fi

# Each script invocation owns a distinct job. Do not delete it on EXIT: the
# RunJob API has no idempotency token, so the Cloud SDK may have retried an
# accepted request whose execution is still active even after another retry
# completed. Cloud Run job deletion would terminate that execution. Stale jobs
# must be garbage-collected separately only after their executions are known
# terminal and old enough to exceed the configured task timeout; the
# `maraithon-deployment-job=true` label gives that collector a narrow scope.

verify_deployment_controller_lock

if ! gcloud run jobs deploy "${deployment_job}" \
  --project "${project}" \
  --region "${region}" \
  --image "${pinned_image}" \
  --service-account "${runtime_service_account}" \
  --set-cloudsql-instances "${connection}" \
  --set-env-vars "${maintenance_env}" \
  --set-secrets "${migration_secrets}" \
  --labels "maraithon-deployment-job=true" \
  --command /app/bin/maraithon \
  --args="^@^eval@raise(\"deployment job requires an explicit execution override\")" \
  --cpu 1 \
  --memory 2Gi \
  --tasks 1 \
  --parallelism 1 \
  --task-timeout 30m \
  --max-retries 0 \
  --quiet; then
  exit 1
fi

verify_deployment_job

probe_target_revision
probe_target_web_revision

case "${deployment_resume_phase}" in
  new | handoff | retarget)
    if [[ "${target_revision_exists}" == "true" ||
          "${target_web_revision_exists}" == "true" ]]; then
      echo "A target revision already exists; refusing database migration before its exact recovery phase is selected" >&2
      echo "Runtime target exists: ${target_revision_exists} (${expected_revision})" >&2
      echo "Web target exists: ${target_web_revision_exists} (${expected_web_revision})" >&2
      exit 1
    fi
    ;;

  activating | stable)
    if [[ "${target_revision_exists}" != "true" ]]; then
      echo "${deployment_resume_phase} recovery runtime revision does not exist: ${expected_revision}" >&2
      exit 1
    fi
    verify_target_revision
    ;;

  deploying)
    ;;
esac

deployment_gate_transition preflight_migration
handoff_already_proven=false

# Select the durable target before draining. New and handoff phases defer every
# migration newer than the gate until the exact runtime is quiescent and the
# handoff is irreversibly deploying. The persistent Cloud Run CAS mutex admits
# only this controller before any migration or durable gate transition.
case "${deployment_resume_phase}" in
  new)
    run_gate_bootstrap_migrations

    if [[ "${stable_source_unavailable_recovery}" == "true" ]]; then
      echo "WARNING: using confirmed stable-runtime-source-unavailable recovery" >&2
      deployment_gate_transition assert_unavailable_stable
      verify_unavailable_stable_revision
      global_quiescence_db_preflight
      deployment_gate_may_be_closed=true
      deployment_gate_transition arm
      # Arm closes admission; prove repeats quiescence transactionally. Any
      # unresolved task still requires the normal incident attestation first.
      deployment_gate_transition prove
      run_full_migrations
      handoff_already_proven=true
    else
      # Prove that this controller can reach the authoritative drain endpoint
      # before closing admission. An orphaned dormant runtime service must not
      # override a durable stable generation that still belongs to the web
      # service during the first split rollout.
      select_runtime_source

      preflight_status_json="$(runtime_status)"
      if ! jq -e 'type == "object" and (.phase | type) == "string"' \
        >/dev/null 2>&1 <<<"${preflight_status_json}"; then
        echo "The prospective runtime drain endpoint is not reachable; admission remains open" >&2
        exit 1
      fi

      deployment_gate_may_be_closed=true
      deployment_gate_transition arm
    fi
    ;;

  handoff)
    if [[ "${stable_source_unavailable_recovery}" == "true" ]]; then
      echo "Resuming the exact unavailable-stable-source handoff without inventing an HTTP drain" >&2
      deployment_gate_transition assert_unavailable_handoff
      verify_unavailable_stable_revision
      global_quiescence_db_preflight
      deployment_gate_transition prove
      run_full_migrations
      handoff_already_proven=true
    elif [[ "${legacy_web_source_unavailable_recovery}" == "true" ]]; then
      echo "Resuming the one-time unavailable legacy web/runtime handoff without inventing an HTTP drain" >&2
      # This predicate requires the current handoff to retain the literal
      # legacy source and proves that no nonlegacy generation has ever become
      # stable. The exact operator-attested web revision must then be absent
      # or non-Ready, and the database proof remains authoritative for work.
      deployment_gate_transition assert_initial_handoff
      verify_unavailable_legacy_web_revision
      global_quiescence_db_preflight
      deployment_gate_transition prove
      run_full_migrations
      handoff_already_proven=true
    else
      deployment_gate_transition arm
    fi
    ;;

  retarget)
    echo "WARNING: break-glass retarget confirmed; predecessor controller/jobs must remain stopped and Cloud Run service operations quiescent" >&2
    verify_retarget_source_revision

    if [[ "${retarget_from_phase}" == "activating" ]]; then
      if [[ "${retarget_source_revision_exists}" == "true" &&
            "${retarget_source_revision_ready}" == "true" ]]; then
        probe_cloud_run_service "${runtime_service}"
        if [[ "${cloud_run_service_exists}" != "true" ]]; then
          echo "The runtime service required to drain the activating predecessor is absent" >&2
          exit 1
        fi

        grant_deployer_runtime_invocation
        verify_runtime_service_private
        verify_deployment_controller_lock

        gcloud run services update-traffic "${runtime_service}" \
          --project "${project}" \
          --region "${region}" \
          --to-revisions "${retarget_from_generation}=100" \
          --quiet

        verify_revision_traffic "${runtime_service}" "${retarget_from_generation}"
        set_api_token_from_serving_revision "${runtime_service}"
        configure_runtime_control "${runtime_service}"

        if ! request_runtime_drain >/dev/null; then
          echo "Ready activating predecessor drain request failed; retarget is refused" >&2
          exit 1
        fi

        retarget_source_drained=false
        for _attempt in $(seq 1 48); do
          status_json="$(runtime_status)"

          if runtime_status_matches_strong_drain "${status_json}" ||
            runtime_status_matches_dormant_global_drain "${status_json}"; then
            retarget_source_drained=true
            break
          fi

          sleep 5
        done

        if [[ "${retarget_source_drained}" != "true" ]]; then
          echo "Ready activating predecessor did not reach a strong drain boundary" >&2
          echo "Last runtime status: ${status_json:-unknown}" >&2
          exit 1
        fi
      else
        echo "Activating predecessor is authoritatively absent or non-Ready; HTTP drain is impossible" >&2
        echo "Proceeding only to the full database quiescence proof under the explicit retarget confirmation" >&2
      fi
    fi

    global_quiescence_db_preflight
    deployment_gate_transition retarget
    run_full_migrations
    ;;

  deploying)
    deployment_gate_transition assert_deploying
    # Every irreversible handoff selects/proves its target before migrating,
    # so an interruption can durably be deploying with migrations incomplete.
    # Re-running the exact target image's migrations is idempotent.
    run_full_migrations
    ;;

  activating)
    deployment_gate_transition assert_activating
    ;;

  stable)
    # Stabilization is only attempted after full migration and target startup.
    deployment_gate_transition assert_stable
    ;;
esac

probe_target_revision

case "${deployment_resume_phase}" in
  new | handoff)
    if [[ "${handoff_already_proven}" == "true" ]]; then
      echo "Stable-source-unavailable recovery already proved the fresh target handoff"
    else
      if [[ "${target_revision_exists}" == "true" ]]; then
        echo "Refusing to continue a handoff for existing immutable revision ${expected_revision}" >&2
        echo "Choose a new MARAITHON_GCP_REVISION_SUFFIX, or explicitly resume the matching durable phase" >&2
        exit 1
      fi

    select_runtime_source
    echo "Runtime drain source: ${source_runtime_service} (${runtime_control_url})"

    if ! request_runtime_drain >/dev/null; then
      echo "Runtime drain request failed; refusing to replace the serving revision" >&2
      exit 1
    fi

    echo "Draining the serving revision's runtime before replacement"
    runtime_drained=false
    legacy_contract_authorized=false
    legacy_contract_checked=false

    for _attempt in $(seq 1 48); do
      status_json="$(runtime_status)"

      # Draining partitions remain owned until the replacement's ready planner
      # releases them. This status is a progress hint; the gate transition
      # below repeats the authoritative proof while holding the protocol lock.
      if runtime_status_matches_strong_drain "${status_json}"; then
        echo "Runtime drain status reached the strong handoff boundary"
        runtime_drained=true
        break
      fi

      if runtime_status_matches_dormant_global_drain "${status_json}"; then
        echo "Runtime restarted dormant with no node after global work reached the handoff boundary"
        runtime_drained=true
        break
      fi

      # Only a database-proven first cutover may use the legacy controller
      # shape. Once any non-legacy generation has become stable, the history
      # predicate can never become true again.
      if runtime_status_has_legacy_contract "${status_json}"; then
        if [[ "${legacy_contract_checked}" != "true" ]]; then
          legacy_contract_checked=true

          if deployment_gate_transition assert_initial_handoff; then
            legacy_contract_authorized=true
          fi
        fi

        if [[ "${legacy_contract_authorized}" != "true" ]]; then
          echo "Serving revision exposes a legacy runtime status after the initial cutover boundary" >&2
          exit 1
        fi

        if runtime_status_matches_legacy_dormant "${status_json}"; then
          if global_quiescence_db_preflight; then
            echo "Runtime restart reached the one-time legacy dormant boundary plus full database quiescence proof"
            runtime_drained=true
            break
          fi

          echo "Legacy runtime is dormant, but the authoritative global quiescence proof failed" >&2
          exit 1
        fi

        if runtime_status_matches_legacy_drain "${status_json}"; then
          if ! legacy_node_id="$(
            jq -er '.node_incarnation_id | select(type == "string")' <<<"${status_json}"
          )"; then
            echo "Legacy runtime status did not contain a string node incarnation id" >&2
            exit 1
          fi

          if [[ "${legacy_node_id}" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] &&
            legacy_drain_db_preflight "${legacy_node_id}"; then
            echo "Runtime drain reached the one-time legacy boundary plus database preflight"
            runtime_drained=true
            break
          fi

          echo "Legacy runtime drain database preflight failed" >&2
          exit 1
        fi
      fi

      sleep 5
    done

    echo "Runtime status before authoritative proof: ${status_json:-unknown}"

    if [[ "${runtime_drained}" != "true" ]]; then
      echo "Refusing revision replacement while exact runtime work remains unproven" >&2
      echo "If a pre-proof restart is stuck with ready partitions, use the incident-only abort for exactly ${expected_revision} / ${image_digest} only after confirming no out-of-band migration execution was launched, then retry with a fresh deployment identity" >&2
      exit 1
    fi

      deployment_gate_transition prove
      run_full_migrations
    fi
    ;;

  retarget)
    if [[ "${target_revision_exists}" == "true" ]]; then
      echo "Retarget generation already exists in Cloud Run: ${expected_revision}" >&2
      echo "Use MARAITHON_DEPLOYMENT_RESUME_PHASE=deploying only if the durable gate already names it" >&2
      exit 1
    fi

    ;;

  deploying | activating | stable)
    ;;
esac

# Cloud Run mutations and the PostgreSQL gate cannot share one transaction.
# The persistent Cloud Run Job token/UID/etag CAS is the controller exclusion
# contract. PostgreSQL gate transitions remain the work-admission authority,
# and stabilization remains the final exact-runtime admission proof.
assert_target_gate_phase

if [[ "${deployment_resume_phase}" == "stable" &&
      "${target_revision_exists}" != "true" ]]; then
  echo "Stable gate names a Cloud Run runtime revision that does not exist: ${expected_revision}" >&2
  exit 1
fi

# The runtime service owns exactly one manually scaled process. Cloud Run can
# still overlap revision instances while traffic moves, so PostgreSQL admission
# -- never the platform instance count -- remains the singleton authority.
probe_cloud_run_service "${runtime_service}"
runtime_service_preexisting="${cloud_run_service_exists}"

if [[ "${target_revision_exists}" == "true" ]]; then
  echo "Reconciling existing immutable runtime revision ${expected_revision}"
else
  if ! deploy_runtime_candidate "${runtime_service_preexisting}"; then
    echo "The durable deployment gate remains closed in deploying state" >&2
    echo "Resume only with the printed revision suffix, image digest, and MARAITHON_DEPLOYMENT_RESUME_PHASE=deploying" >&2
    exit 1
  fi

  target_revision_exists=true
fi

if ! verify_target_revision; then
  print_target_diagnostics
  echo "The durable deployment gate remains closed" >&2
  exit 1
fi

api_token="${target_api_token}"
grant_deployer_runtime_invocation
verify_runtime_service_private
verify_runtime_service_rejects_unauthenticated
verify_service_scaling "${runtime_service}" manual "" "" 1
configure_runtime_control "${runtime_service}"

assert_target_gate_phase
verify_deployment_controller_lock

if ! gcloud run services update-traffic "${runtime_service}" \
  --project "${project}" \
  --region "${region}" \
  --to-revisions "${expected_revision}=100" \
  --quiet; then
  echo "Runtime traffic update failed or was ambiguous; inspect Cloud Run before exact recovery" >&2
  exit 1
fi

assert_target_gate_phase

if ! verify_target_traffic; then
  echo "The durable deployment gate remains closed" >&2
  exit 1
fi

# With 100% runtime traffic, the authenticated response is an exact observation
# of the target K_REVISION and of the same database's durable gate projection.
# Admission remains closed while deploying. Activating admits only this target;
# stabilization is attempted only after both local status and transactional DB
# readiness prove the target exact runtime is complete.
case "${deployment_resume_phase}" in
  stable)
    deployment_gate_transition assert_stable
    ;;

  activating)
    deployment_gate_transition assert_activating
    ;;

  new | handoff | deploying | retarget)
    target_dormant=false

    for _attempt in $(seq 1 24); do
      status_json="$(runtime_status)"

      if runtime_status_matches_dormant_generation \
        "${status_json}" "${expected_revision}" "${image_digest}"; then
        target_dormant=true
        break
      fi

      sleep 5
    done

    if [[ "${target_dormant}" != "true" ]]; then
      echo "Target runtime did not prove dormant identity plus the deploying gate" >&2
      echo "Last runtime status: ${status_json:-unknown}" >&2
      echo "Resume in deploying phase with the exact printed identities" >&2
      exit 1
    fi

    deployment_gate_transition activate
    ;;
esac

if [[ "${deployment_resume_phase}" != "stable" ]]; then
  runtime_ready_activating=false

  for _attempt in $(seq 1 60); do
    status_json="$(runtime_status)"

    if runtime_status_matches_ready_activating_generation \
      "${status_json}" "${expected_revision}" "${image_digest}"; then
      runtime_ready_activating=true
      break
    fi

    sleep 5
  done

  if [[ "${runtime_ready_activating}" != "true" ]]; then
    echo "Target runtime was admitted, but did not become exactly ready while the gate remained activating" >&2
    echo "Last runtime status: ${status_json:-unknown}" >&2
    echo "Resume in activating phase with the exact printed identities" >&2
    exit 1
  fi

  deployment_gate_transition stabilize
fi

runtime_ready_stable=false

for _attempt in $(seq 1 24); do
  status_json="$(runtime_status)"

  if runtime_status_matches_ready_stable_generation \
    "${status_json}" "${expected_revision}" "${image_digest}"; then
    runtime_ready_stable=true
    break
  fi

  sleep 5
done

if [[ "${runtime_ready_stable}" != "true" ]]; then
  echo "Target runtime did not prove exact readiness with the same generation stably admitted" >&2
  echo "Last runtime status: ${status_json:-unknown}" >&2
  echo "Resume in stable phase with the exact printed identities" >&2
  exit 1
fi

deployment_gate_transition assert_stable
deployment_gate_may_be_closed=false

# Keep the current public revision live throughout the exact-runtime handoff.
# Only after the new runtime is DB-admitted and ready do we create/reconcile
# and promote the autoscaled web-only revision.
probe_target_web_revision

if [[ "${target_web_revision_exists}" == "true" ]]; then
  echo "Reconciling existing immutable web revision ${expected_web_revision}"
else
  if ! deploy_web_candidate; then
    echo "Exact runtime is stable; resume the same deployment in stable phase to finish web promotion" >&2
    exit 1
  fi

  target_web_revision_exists=true
fi

if ! verify_target_web_revision; then
  print_target_web_diagnostics
  echo "Exact runtime is stable; the web candidate was not promoted" >&2
  exit 1
fi

# Public IAM is a distinct control-plane mutation from immutable revision
# creation. Reconcile it independently so an ambiguous deploy can resume after
# creating the exact revision but before its --allow-unauthenticated step lands.
deployment_gate_transition assert_stable
grant_public_web_invocation
verify_web_service_public
verify_service_scaling "${service}" automatic 1 5 ""

deployment_gate_transition assert_stable
verify_deployment_controller_lock

if ! gcloud run services update-traffic "${service}" \
  --project "${project}" \
  --region "${region}" \
  --to-revisions "${expected_web_revision}=100" \
  --quiet; then
  echo "Web traffic update failed or was ambiguous; exact runtime remains stable" >&2
  exit 1
fi

deployment_gate_transition assert_stable

if ! verify_target_web_traffic; then
  echo "Exact runtime is stable, but web traffic did not converge to ${expected_web_revision}" >&2
  exit 1
fi

web_service_url="$(cloud_run_service_url "${service}")"
web_generation_observed=false

for _attempt in $(seq 1 24); do
  web_health_json="$(
    curl --silent --show-error --fail --max-time 15 \
      "${web_service_url}/health" 2>/dev/null || true
  )"

  if jq -e --arg generation "${expected_web_revision}" '
    type == "object" and
    .status == "ok" and
    .process_role == "web" and
    .deployment_generation == $generation
  ' >/dev/null 2>&1 <<<"${web_health_json}"; then
    web_generation_observed=true
    break
  fi

  sleep 5
done

if [[ "${web_generation_observed}" != "true" ]]; then
  echo "The public Cloud Run service did not identify as ${expected_web_revision}" >&2
  echo "Last health response: ${web_health_json:-unknown}" >&2
  exit 1
fi

health_url="https://${web_host}/health"
curl --fail --silent --show-error --max-time 15 "${health_url}" >/dev/null
curl --fail --silent --show-error --max-time 15 https://maraithon.com/health >/dev/null
echo "Split web/runtime identity, traffic, role, and exact-readiness checks passed: ${expected_web_revision} / ${expected_revision}"

# The core rollout is complete. Release only after both traffic targets and
# health identities are proven; optional product validation below does not
# mutate the exact-runtime deployment state and must not retain the mutex.
verify_deployment_controller_lock
release_deployment_controller_lock

if [[ -n "${todo_validation_user}" ]]; then
  if [[ "${todo_validation_user}" != "kent@runner.now" ]]; then
    echo "Refusing Todo validation for an unauthorized account" >&2
    exit 64
  fi

  gcloud run jobs deploy "${service}-todo-validation"     --project "${project}"     --region "${region}"     --image "${pinned_image}"     --service-account "${runtime_service_account}"     --set-cloudsql-instances "${connection}"     --set-env-vars "${maintenance_env},DURABLE_PAYLOAD_BINDING_CURRENT_TAG=HMAC.SHA256.V1,TODO_VALIDATION_USER=${todo_validation_user}"     --set-secrets "${runtime_secrets}"     --command /app/bin/maraithon     --args eval,Maraithon.Release.validate_authorized_todo_launch     --cpu 1     --memory 2Gi     --task-timeout 15m     --max-retries 0     --quiet

  validation_started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  if ! gcloud run jobs execute "${service}-todo-validation"     --project "${project}"     --region "${region}"     --wait     --quiet; then
    validation_error=""

    for _attempt in $(seq 1 20); do
      validation_error="$(gcloud logging read       "resource.type=cloud_run_job AND resource.labels.job_name=${service}-todo-validation AND timestamp>=\"${validation_started_at}\" AND textPayload:\"TODO_OUTCOME_VALIDATION_ERROR=\""       --project "${project}"       --limit 1       --order=desc       --format 'value(textPayload)' 2>/dev/null || true)"

      if [[ "${validation_error}" == TODO_OUTCOME_VALIDATION_ERROR=* ]]; then
        break
      fi

      sleep 3
    done

    if [[ "${validation_error}" == TODO_OUTCOME_VALIDATION_ERROR=* ]]; then
      echo "${validation_error}" >&2
    else
      echo "Todo validation failed before an aggregate-only error report was available" >&2
    fi

    coordination_log="$(gcloud logging read \
      "resource.type=cloud_run_revision AND resource.labels.service_name=${runtime_service} AND timestamp>=\"${validation_started_at}\" AND (textPayload:\"RUNTIME_COORDINATION_ERROR=\" OR jsonPayload.message:\"RUNTIME_COORDINATION_ERROR=\")" \
      --project "${project}" \
      --limit 20 \
      --order=desc \
      --format 'value(textPayload,jsonPayload.message)' 2>/dev/null || true)"
    coordination_error="$(printf '%s\n' "${coordination_log}" | \
      grep -Eo 'RUNTIME_COORDINATION_ERROR=[a-z0-9_:,-]+' | head -n 1 || true)"

    if [[ "${coordination_error}" == RUNTIME_COORDINATION_ERROR=* ]]; then
      echo "${coordination_error}" >&2
    fi

    exit 1
  fi

  validation_report=""
  for _attempt in $(seq 1 20); do
    validation_report="$(gcloud logging read       "resource.type=cloud_run_job AND resource.labels.job_name=${service}-todo-validation AND timestamp>=\"${validation_started_at}\" AND textPayload:\"TODO_LAUNCH_VALIDATION=\""       --project "${project}"       --limit 1       --order=desc       --format 'value(textPayload)' 2>/dev/null || true)"

    if [[ "${validation_report}" == TODO_LAUNCH_VALIDATION=* ]]; then
      break
    fi

    sleep 3
  done

  if [[ "${validation_report}" != TODO_LAUNCH_VALIDATION=* ]]; then
    echo "Todo validation completed but its aggregate-only report was not available" >&2
    exit 1
  fi

  echo "${validation_report}"
fi

echo "Deployed image revision: ${revision}"
echo "Deployed image digest: ${image_digest}"
echo "Cloud Run web revision: ${expected_web_revision}"
echo "Cloud Run runtime revision: ${expected_revision}"
echo "Runtime protocol revision: ${protocol_revision}"
