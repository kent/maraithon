verify_retarget_source_revision() {
  local described_name
  local ready_status
  local status_image
  local spec_image
  local revision_json
  local expected_image="${image_repository}@${retarget_from_image_digest}"

  retarget_source_revision_exists=false
  retarget_source_revision_ready=false

  if described_name="$(
    gcloud --verbosity=error run revisions describe "${retarget_from_generation}" \
      --project "${project}" \
      --region "${region}" \
      --format='value(metadata.name)' 2>&1
  )"; then
    if [[ "${described_name}" != "${retarget_from_generation}" ]]; then
      echo "Cloud Run returned an unexpected retarget source identity: ${described_name}" >&2
      return 1
    fi
    retarget_source_revision_exists=true
  elif revision_describe_not_found "${described_name}" "${retarget_from_generation}"; then
    echo "Retarget source revision is authoritatively absent and unusable: ${retarget_from_generation}"
    return 0
  else
    echo "Unable to determine whether retarget source revision ${retarget_from_generation} exists" >&2
    echo "${described_name}" >&2
    return 1
  fi

  if ! ready_status="$(
    gcloud run revisions describe "${retarget_from_generation}" \
      --project "${project}" \
      --region "${region}" \
      --format='value(status.conditions.filter("type=Ready").extract(status).flatten())'
  )"; then
    echo "Unable to read the retarget source revision's Ready condition" >&2
    return 1
  fi

  if [[ "${ready_status}" == "True" ]]; then
    retarget_source_revision_ready=true
  fi

  if ! status_image="$(
    gcloud run revisions describe "${retarget_from_generation}" \
      --project "${project}" \
      --region "${region}" \
      --format='value(status.imageDigest)'
  )"; then
    return 1
  fi

  if ! spec_image="$(
    gcloud run revisions describe "${retarget_from_generation}" \
      --project "${project}" \
      --region "${region}" \
      --format='value(spec.containers[0].image)'
  )"; then
    return 1
  fi

  if [[ "${spec_image}" != "${expected_image}" ]]; then
    echo "Retarget source revision spec does not use its gated image" >&2
    echo "Expected: ${expected_image}" >&2
    echo "Actual:   ${spec_image:-unknown}" >&2
    return 1
  fi

  if [[ -n "${status_image}" &&
        "${status_image}" != "${expected_image}" &&
        "${status_image}" != "${retarget_from_image_digest}" ]]; then
    echo "Retarget source revision status has a different image digest" >&2
    echo "Expected full ref or bare digest: ${expected_image} / ${retarget_from_image_digest}" >&2
    echo "Actual: ${status_image}" >&2
    return 1
  fi

  if ! revision_json="$(
    gcloud run revisions describe "${retarget_from_generation}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )" || ! jq -e \
    --arg service "${runtime_service}" \
    --arg service_account "${runtime_service_account}" '
      def env_value($name):
        [.spec.containers[0].env[]? | select(.name == $name) | .value] | first;

      .metadata.labels["serving.knative.dev/service"] == $service and
      .spec.serviceAccountName == $service_account and
      env_value("MARAITHON_PROCESS_ROLE") == "runtime" and
      env_value("EXACT_AGENT_RUNTIME_ENABLED") == "true" and
      env_value("MULTINODE_COORDINATION_ENABLED") == "true"
    ' >/dev/null 2>&1 <<<"${revision_json}"; then
    echo "Retarget source revision is not an exact runtime-service revision" >&2
    return 1
  fi

  echo "WARNING: explicitly retargeting operator-declared unusable revision ${retarget_from_generation} (Ready=${ready_status:-unknown})" >&2
}

