if [[ "${project}" != "maraithon" ||
      "${region}" != "us-central1" ||
      "${service}" != "maraithon" ||
      "${runtime_service}" != "maraithon-runtime" ||
      "${repository}" != "maraithon" ||
      "${database_instance}" != "maraithon-db" ||
      "${runtime_service_account}" != "maraithon-runtime@maraithon.iam.gserviceaccount.com" ||
      "${web_service_account}" != "maraithon-runtime@maraithon.iam.gserviceaccount.com" ||
      "${deployer_service_account}" != "admin-deployer@maraithon.iam.gserviceaccount.com" ||
      "${exact_runtime_enabled}" != "true" ||
      "${coordination_enabled}" != "true" ]]; then
