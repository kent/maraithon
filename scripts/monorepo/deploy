deployment_gate_transition() {
  local action="$1"
  local expression

  verify_deployment_controller_lock || return 1

  expression="$(cat <<'ELIXIR'
Application.load(:maraithon)
action = System.fetch_env!("RUNTIME_DEPLOYMENT_GATE_ACTION")
target_generation = System.fetch_env!("RUNTIME_DEPLOYMENT_GATE_GENERATION")
image_digest = System.fetch_env!("RUNTIME_DEPLOYMENT_GATE_IMAGE_DIGEST")
previous_generation = System.get_env("RUNTIME_DEPLOYMENT_GATE_PREVIOUS_GENERATION")
previous_image_digest = System.get_env("RUNTIME_DEPLOYMENT_GATE_PREVIOUS_IMAGE_DIGEST")
previous_phase = System.get_env("RUNTIME_DEPLOYMENT_GATE_PREVIOUS_PHASE")
unavailable_stable_generation =
  System.get_env("RUNTIME_DEPLOYMENT_UNAVAILABLE_STABLE_GENERATION")

unavailable_stable_image_digest =
  System.get_env("RUNTIME_DEPLOYMENT_UNAVAILABLE_STABLE_IMAGE_DIGEST")
resume_phase = System.fetch_env!("RUNTIME_DEPLOYMENT_RESUME_PHASE")
protocol_revision = System.fetch_env!("RUNTIME_DEPLOYMENT_PROTOCOL_REVISION")
web_service = System.fetch_env!("RUNTIME_DEPLOYMENT_WEB_SERVICE")
runtime_service = System.fetch_env!("RUNTIME_DEPLOYMENT_RUNTIME_SERVICE")

{:ok, result, _apps} =
  Ecto.Migrator.with_repo(Maraithon.Repo, fn repo ->
    case action do
      "arm" ->
        Maraithon.Runtime.Coordination.Authority.arm_deployment_handoff(
          target_generation,
          image_digest
        )

      "prove" ->
        Maraithon.Runtime.Coordination.Authority.prove_deployment_handoff(
          target_generation,
          image_digest
        )

      "activate" ->
        Maraithon.Runtime.Coordination.Authority.activate_deployment_generation(
          target_generation,
          image_digest
        )

      "stabilize" ->
        # The authenticated runtime status can become ready just before a
        # replaced same-revision instance's lease expires. The authority
        # transaction rolls back with this one closed error while that overlap
        # remains visible. Retry only that typed result inside this single job
        # execution; every other error still fails immediately below.
        stabilize = fn stabilize, attempt ->
          case Maraithon.Runtime.Coordination.Authority.stabilize_deployment_generation(
                 target_generation,
                 image_digest
               ) do
            {:error, :deployment_generation_not_ready} when attempt < 13 ->
              IO.puts(
                "Runtime deployment generation is not transactionally ready; " <>
                  "retrying stabilization (#{attempt}/12)"
              )

              Process.sleep(5_000)
              stabilize.(stabilize, attempt + 1)

            result ->
              result
          end
        end

        stabilize.(stabilize, 1)

      "abort" ->
        # Incident-only primitive: never call this from automatic cleanup. The
        # operator must supply the exact target/digest and first confirm that
        # no out-of-band migration execution was launched for this handoff.
        Maraithon.Runtime.Coordination.Authority.abort_deployment_handoff(
          target_generation,
          image_digest
        )

      "retarget" ->
        Maraithon.Runtime.Coordination.Authority.retarget_deployment_handoff(
          previous_generation,
          previous_image_digest,
          target_generation,
          image_digest
        )

      "preflight_migration" ->
        protocol_table_exists =
          repo.query!(
            "SELECT pg_catalog.to_regclass('public.runtime_coordination_protocols') IS NOT NULL",
            []
          ).rows == [[true]]

        runtime_protocol =
          if protocol_table_exists do
            case repo.query!(
                   "SELECT mode, exact_revision FROM public.runtime_coordination_protocols WHERE name = 'runtime'",
                   []
                 ).rows do
              [[mode, exact_revision]] -> %{mode: mode, exact_revision: exact_revision}
              [] -> nil
            end
          end

        node_table_exists =
          repo.query!(
            "SELECT pg_catalog.to_regclass('public.runtime_node_incarnations') IS NOT NULL",
            []
          ).rows == [[true]]

        schema_migrations_exists =
          repo.query!(
            "SELECT pg_catalog.to_regclass('public.schema_migrations') IS NOT NULL",
            []
          ).rows == [[true]]

        gate_installed =
          schema_migrations_exists and
            repo.query!(
              "SELECT EXISTS (SELECT 1 FROM public.schema_migrations WHERE version = $1)",
              [20_260_904_190_000]
            ).rows == [[true]]

        latest =
          if node_table_exists do
            case repo.query!(
                   """
                   SELECT metadata
                   FROM public.runtime_node_incarnations
                   WHERE node_name = '__maraithon_deployment_gate__'
                     AND metadata ->> 'kind' = 'deployment_gate'
                   ORDER BY (metadata ->> 'sequence')::bigint DESC
                   LIMIT 1
                   """,
                   []
                 ).rows do
              [[metadata]] -> metadata
              [] -> nil
            end
          end

        target_used =
          node_table_exists and
            repo.query!(
              """
              SELECT EXISTS (
                SELECT 1
                FROM public.runtime_node_incarnations
                WHERE node_name = '__maraithon_deployment_gate__'
                  AND metadata ->> 'kind' = 'deployment_gate'
                  AND $1 IN (
                    metadata ->> 'target_generation',
                    metadata ->> 'stable_generation',
                    metadata ->> 'previous_generation'
                  )
              )
              """,
              [target_generation]
            ).rows == [[true]]

        %{
          gate_installed: gate_installed,
          latest: latest,
          node_table_exists: node_table_exists,
          runtime_protocol: runtime_protocol,
          target_used: target_used
        }

      phase
      when phase in [
             "assert_deploying",
             "assert_activating",
             "assert_stable",
             "assert_unavailable_stable",
             "assert_source_runtime",
             "assert_source_web"
           ] ->
        repo.query!(
          """
          SELECT (metadata ->> 'sequence')::bigint,
                 metadata ->> 'state',
                 metadata ->> 'target_generation',
                 metadata ->> 'stable_generation',
                 metadata ->> 'previous_generation',
                 metadata ->> 'image_digest'
          FROM public.runtime_node_incarnations
          WHERE node_name = '__maraithon_deployment_gate__'
            AND metadata ->> 'kind' = 'deployment_gate'
          ORDER BY (metadata ->> 'sequence')::bigint DESC
          LIMIT 1
          """,
          []
        ).rows

      "assert_initial_handoff" ->
        repo.query!(
          """
          WITH latest AS (
            SELECT metadata
            FROM public.runtime_node_incarnations
            WHERE node_name = '__maraithon_deployment_gate__'
              AND metadata ->> 'kind' = 'deployment_gate'
            ORDER BY (metadata ->> 'sequence')::bigint DESC
            LIMIT 1
          )
          SELECT EXISTS (
            SELECT 1
            FROM latest
            WHERE metadata ->> 'state' = 'handoff'
              AND metadata ->> 'target_generation' = $1
              AND metadata ->> 'stable_generation' = 'legacy'
              AND metadata ->> 'previous_generation' = 'legacy'
              AND metadata ->> 'image_digest' = $2
              AND NOT EXISTS (
                SELECT 1
                FROM public.runtime_node_incarnations AS marker
                WHERE marker.node_name = '__maraithon_deployment_gate__'
                  AND marker.metadata ->> 'kind' = 'deployment_gate'
                  AND marker.metadata ->> 'state' = 'stable'
                  AND marker.metadata ->> 'stable_generation' <> 'legacy'
              )
          )
          """,
          [target_generation, image_digest]
        ).rows

      "assert_unavailable_handoff" ->
        repo.query!(
          """
          WITH ordered AS (
            SELECT metadata,
                   row_number() OVER (
                     ORDER BY (metadata ->> 'sequence')::bigint DESC
                   ) AS position
            FROM public.runtime_node_incarnations
            WHERE node_name = '__maraithon_deployment_gate__'
              AND metadata ->> 'kind' = 'deployment_gate'
          )
          SELECT EXISTS (
            SELECT 1
            FROM ordered AS latest
            WHERE latest.position = 1
              AND latest.metadata ->> 'state' = 'handoff'
              AND latest.metadata ->> 'target_generation' = $1
              AND latest.metadata ->> 'stable_generation' = $2
              AND latest.metadata ->> 'previous_generation' = $2
              AND latest.metadata ->> 'image_digest' = $3
              AND EXISTS (
                SELECT 1
                FROM ordered AS prior
                WHERE prior.position > 1
                  AND prior.metadata ->> 'state' = 'stable'
                  AND prior.metadata ->> 'stable_generation' = $2
                  AND prior.metadata ->> 'image_digest' = $4
              )
          )
          """,
          [
            target_generation,
            unavailable_stable_generation,
            image_digest,
            unavailable_stable_image_digest
          ]
        ).rows

      _ ->
        raise "unknown runtime deployment gate action"
    end
  end)

accepted =
  case {action, result} do
    {"arm", {:ok, status}} when status in [:armed, :already_armed] -> status
    {"prove", {:ok, status}} when status in [:proven, :already_proven] -> status
    {"activate", {:ok, status}} when status in [:activated, :already_activating] -> status
    {"stabilize", {:ok, status}} when status in [:stabilized, :already_stable] -> status
    {"abort", {:ok, status}} when status in [:aborted, :already_aborted] -> status
    {"retarget", {:ok, status}} when status in [:retargeted, :already_retargeted] -> status

    {"preflight_migration", gate_state} ->
      case gate_state do
        %{
          runtime_protocol: %{
            mode: "partition_fenced_v1",
            exact_revision: ^protocol_revision
          }
        } ->
          case {resume_phase, gate_state} do
            {"new", %{latest: nil, target_used: false}} ->
              :bootstrap

            {"new",
             %{
               gate_installed: true,
               latest: %{"state" => state},
               target_used: false
             }}
            when state in ["stable", "aborted"] ->
              :open

            {"handoff",
             %{
               gate_installed: true,
               latest: %{
                 "state" => "handoff",
                 "target_generation" => ^target_generation,
                 "image_digest" => ^image_digest
               }
             }} ->
              :handoff

            {"deploying",
             %{
               gate_installed: true,
               latest: %{
                 "state" => "deploying",
                 "target_generation" => ^target_generation,
                 "image_digest" => ^image_digest
               }
             }} ->
              :deploying

            {"activating",
             %{
               gate_installed: true,
               latest: %{
                 "state" => "activating",
                 "target_generation" => ^target_generation,
                 "image_digest" => ^image_digest
               }
             }} ->
              :activating

            {"retarget",
             %{
               gate_installed: true,
               target_used: false,
               latest: %{
                 "state" => state,
                 "target_generation" => ^previous_generation,
                 "image_digest" => ^previous_image_digest
               }
             }}
            when state == previous_phase and state in ["deploying", "activating"] ->
              :retarget

            {"stable",
             %{
               gate_installed: true,
               latest: %{
                 "state" => "stable",
                 "target_generation" => ^target_generation,
                 "stable_generation" => ^target_generation,
                 "image_digest" => ^image_digest
               }
             }} ->
              :stable

            other ->
              raise "runtime deployment migration preflight failed: #{inspect(other)}"
          end

        other ->
          raise "runtime deployment protocol preflight failed: #{inspect(other)}"
      end

    {"assert_deploying",
     [[_sequence, "deploying", ^target_generation, _stable, _previous, ^image_digest]]} ->
      :deploying

    {"assert_activating",
     [[_sequence, "activating", ^target_generation, _stable, _previous, ^image_digest]]} ->
      :activating

    {"assert_initial_handoff", [[true]]} ->
      :initial_handoff

    {"assert_unavailable_handoff", [[true]]} ->
      :unavailable_handoff

    {"assert_stable",
     [[_sequence, "stable", ^target_generation, ^target_generation, _previous, ^image_digest]]} ->
      :stable

    {"assert_unavailable_stable",
     [[_sequence, "stable", ^unavailable_stable_generation,
       ^unavailable_stable_generation, _previous, ^unavailable_stable_image_digest]]} ->
      :unavailable_stable

    {"assert_source_web", []} ->
      :web

    {source_action,
     [[_sequence, _state, _target_generation, stable_generation, _previous, _image_digest]]}
    when source_action in ["assert_source_runtime", "assert_source_web"] ->
      runtime_source? = String.starts_with?(stable_generation, runtime_service <> "-")

      web_source? =
        stable_generation == "legacy" or
          (String.starts_with?(stable_generation, web_service <> "-") and not runtime_source?)

      case {source_action, runtime_source?, web_source?} do
        {"assert_source_runtime", true, _} -> :runtime
        {"assert_source_web", _, true} -> :web
        _ -> raise "runtime deployment source service does not match the durable stable generation"
      end

    other ->
      raise "runtime deployment gate action failed: #{inspect(other)}"
  end

