  echo "Expected project=maraithon region=us-central1 web-service=maraithon runtime-service=maraithon-runtime repository=maraithon database=maraithon-db web/runtime-service-account=maraithon-runtime@maraithon.iam.gserviceaccount.com deployer-service-account=admin-deployer@maraithon.iam.gserviceaccount.com exact-runtime=true coordination=true" >&2
