      --project "${project}" \
      --region "${region}" \
      --format=json
  )"; then
    echo "Unable to read the IAM policy for ${runtime_service}" >&2
    return 1
  fi

  if ! jq -e --arg deployer "serviceAccount:${deployer_service_account}" '
    [.bindings[]?.members[]?] as $members |
    [.bindings[]? | select(.role == "roles/run.invoker") | .members[]?] as $invokers |
    ($members | index("allUsers")) == null and
    ($members | index("allAuthenticatedUsers")) == null and
    ($invokers | index($deployer)) != null
  ' >/dev/null 2>&1 <<<"${policy_json}"; then
    echo "Runtime service ${runtime_service} is public or lacks the pinned deployer invoker binding" >&2
    return 1
  fi

  service_json="$(
    gcloud run services describe "${runtime_service}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"

  if ! jq -e '
    ((.metadata.annotations["run.googleapis.com/invoker-iam-disabled"] // "false") |
      ascii_downcase) != "true"
  ' >/dev/null 2>&1 <<<"${service_json}"; then
    echo "Runtime service ${runtime_service} has the Cloud Run Invoker IAM check disabled" >&2
    return 1
  fi
