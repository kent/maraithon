verify_unavailable_stable_revision() {
  local output
  local revision_json
  local expected_image="${image_repository}@${unavailable_stable_image_digest}"

  if ! output="$(
    gcloud --verbosity=error run revisions describe "${unavailable_stable_generation}" \
      --project "${project}" \
      --region "${region}" \
      --format=json 2>&1
  )"; then
    if revision_describe_not_found "${output}" "${unavailable_stable_generation}"; then
      echo "Stable runtime revision is authoritatively absent: ${unavailable_stable_generation}"
      return 0
    fi

    echo "Unable to prove the stable runtime revision absent or unusable" >&2
    echo "${output}" >&2
    return 1
  fi

  revision_json="${output}"

  if ! jq -e \
    --arg revision "${unavailable_stable_generation}" \
    --arg service "${runtime_service}" \
    --arg image "${expected_image}" \
    --arg digest "${unavailable_stable_image_digest}" '
      .metadata.name == $revision and
      .metadata.labels["serving.knative.dev/service"] == $service and
      .spec.containers[0].image == $image and
      (.status.imageDigest == null or
       .status.imageDigest == "" or
       .status.imageDigest == $image or
       .status.imageDigest == $digest) and
      (any(.status.conditions[]?; .type == "Ready" and .status == "True") | not)
    ' >/dev/null 2>&1 <<<"${revision_json}"; then
    echo "The durable stable runtime revision still exists and is Ready, or its identity/image does not match" >&2
    echo "Use the normal authenticated drain path; unavailable-source recovery is refused" >&2
    return 1
  fi

  echo "Stable runtime revision exists but has no Ready=True condition: ${unavailable_stable_generation}"
}

