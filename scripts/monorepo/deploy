predecessor_controller_token="${MARAITHON_DEPLOYMENT_LOCK_PREDECESSOR_TOKEN:-}"
lock_recovery_confirmation="${MARAITHON_CONFIRM_DEPLOYMENT_LOCK_RECOVERY:-}"
unavailable_stable_generation="${MARAITHON_DEPLOYMENT_UNAVAILABLE_STABLE_GENERATION:-}"
unavailable_stable_image_digest="${MARAITHON_DEPLOYMENT_UNAVAILABLE_STABLE_IMAGE_DIGEST:-}"
unavailable_stable_confirmation="${MARAITHON_CONFIRM_STABLE_SOURCE_UNAVAILABLE:-}"
unavailable_legacy_web_generation="${MARAITHON_DEPLOYMENT_UNAVAILABLE_LEGACY_WEB_GENERATION:-}"
unavailable_legacy_web_image_digest="${MARAITHON_DEPLOYMENT_UNAVAILABLE_LEGACY_WEB_IMAGE_DIGEST:-}"
