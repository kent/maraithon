verify_revision() {
  local revision_name="$1"
  local service_name="$2"
  local process_role="$3"
  local service_account="$4"
  local pool_size="$5"
  local expected_env="$6"
  local expected_concurrency="$7"
  local expected_session_affinity="$8"
  local revision_json

  if ! revision_json="$(
    gcloud run revisions describe "${revision_name}" \
      --project "${project}" \
      --region "${region}" \
      --format=json
  )"; then
    echo "Unable to describe Cloud Run revision ${revision_name}" >&2
    return 1
  fi

  if ! jq -e \
    --arg revision "${revision_name}" \
    --arg service "${service_name}" \
    --arg image "${pinned_image}" \
    --arg digest "${image_digest}" \
    --arg role "${process_role}" \
    --arg service_account "${service_account}" \
    --arg pool_size "${pool_size}" \
    --arg protocol_revision "${protocol_revision}" \
    --arg cloud_sql_connection "${connection}" \
    --arg database_secret_version "${runtime_database_secret_version}" \
    --arg api_token_secret_version "${api_token_secret_version}" \
    --arg secret_bindings "${runtime_secrets}" \
    --arg expected_env "${expected_env}" \
    --arg expected_concurrency "${expected_concurrency}" \
    --arg expected_session_affinity "${expected_session_affinity}" '
      def env_value($name):
        [.spec.containers[0].env[]? | select(.name == $name) | .value] | first;

      def secret_ref($name):
        [.spec.containers[0].env[]? |
          select(.name == $name) |
          .valueFrom.secretKeyRef] | first;
      def expected_secret_refs($bindings):
        reduce ($bindings | split(",")[]) as $binding
          ({};
           ($binding |
             capture("^(?<env>[A-Z0-9_]+)=(?<name>[a-z0-9-]+):(?<key>[1-9][0-9]*)$")) as $parsed |
           .[$parsed.env] = {name: $parsed.name, key: $parsed.key});
      def actual_secret_refs:
        reduce (.spec.containers[0].env[]? | select(.valueFrom.secretKeyRef? != null)) as $env
          ({}; .[$env.name] = $env.valueFrom.secretKeyRef);
      def expected_plain_env($bindings):
        reduce ($bindings | split(",")[]) as $binding
          ({};
           ($binding | capture("^(?<name>[A-Z0-9_]+)=(?<value>.*)$")) as $parsed |
           .[$parsed.name] = $parsed.value);
      def actual_plain_env:
        reduce (.spec.containers[0].env[]? | select(has("value"))) as $env
          ({}; .[$env.name] = $env.value);

      type == "object" and
      .metadata.name == $revision and
      .metadata.labels["serving.knative.dev/service"] == $service and
      .metadata.labels["maraithon-process-role"] == $role and
      .spec.serviceAccountName == $service_account and
      (.spec.containerConcurrency | tostring) == $expected_concurrency and
      (.spec.timeoutSeconds | tostring) == "3600" and
      (.spec.containers | type == "array" and length == 1) and
      ([.spec.containers[0].env[]?.name] | length == (unique | length)) and
      .spec.containers[0].image == $image and
      (.spec.containers[0].resources.limits.cpu | tostring) == "2" and
      .spec.containers[0].resources.limits.memory == "2Gi" and
      (.spec.containers[0].ports | type == "array" and length == 1) and
      (.spec.containers[0].ports[0].containerPort | tostring) == "8080" and
      .spec.containers[0].startupProbe.httpGet.path == "/health" and
      (.spec.containers[0].startupProbe.initialDelaySeconds | tostring) == "5" and
      (.spec.containers[0].startupProbe.timeoutSeconds | tostring) == "5" and
      (.spec.containers[0].startupProbe.periodSeconds | tostring) == "5" and
      (.spec.containers[0].startupProbe.failureThreshold | tostring) == "24" and
      env_value("MARAITHON_PROCESS_ROLE") == $role and
      env_value("POOL_SIZE") == $pool_size and
      env_value("EXACT_AGENT_RUNTIME_ENABLED") == "true" and
      env_value("MULTINODE_COORDINATION_ENABLED") == "true" and
      env_value("PHX_SERVER") == "true" and
      env_value("DATABASE_POOL_MODE") == "session" and
      env_value("GIT_SHA") == $protocol_revision and
      .metadata.annotations["run.googleapis.com/cloudsql-instances"] == $cloud_sql_connection and
      ((.metadata.annotations["run.googleapis.com/cpu-throttling"] // "true") | ascii_downcase) == "false" and
      (if $expected_session_affinity == "true" then
         ((.metadata.annotations["run.googleapis.com/sessionAffinity"] // "false") | ascii_downcase) == "true"
       else
         ((.metadata.annotations["run.googleapis.com/sessionAffinity"] // "false") | ascii_downcase) != "true"
       end) and
      actual_plain_env == expected_plain_env($expected_env) and
      secret_ref("DATABASE_URL").name == "maraithon-runtime-db-url" and
      secret_ref("DATABASE_URL").key == $database_secret_version and
      secret_ref("API_BEARER_TOKEN").name == "maraithon-api-bearer-token" and
      secret_ref("API_BEARER_TOKEN").key == $api_token_secret_version and
      actual_secret_refs == expected_secret_refs($secret_bindings) and
      ([.spec.containers[0].env[]? | .valueFrom.secretKeyRef? | select(.)] |
        all(.[]; (.key | type) == "string" and (.key | test("^[1-9][0-9]*$")))) and
      any(.status.conditions[]?; .type == "Ready" and .status == "True") and
      (.status.imageDigest == $image or .status.imageDigest == $digest)
    ' >/dev/null 2>&1 <<<"${revision_json}"; then
    echo "Cloud Run revision ${revision_name} failed its exact identity, role, image, service-account, or Ready proof" >&2
    return 1
  fi
}

