}

select_runtime_source() {
  probe_cloud_run_service "${runtime_service}"

  if [[ "${cloud_run_service_exists}" == "true" ]] &&
    deployment_gate_transition assert_source_runtime; then
    source_runtime_service="${runtime_service}"
    grant_deployer_runtime_invocation
    verify_runtime_service_private
  else
    deployment_gate_transition assert_source_web
    source_runtime_service="${service}"
  fi

  set_api_token_from_serving_revision "${source_runtime_service}"

  if [[ "${source_runtime_service}" == "${runtime_service}" ]]; then
    verify_runtime_service_rejects_unauthenticated
  fi

  configure_runtime_control "${source_runtime_service}"
}

