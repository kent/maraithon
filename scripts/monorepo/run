#!/usr/bin/env bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

component="${1:-companion}"

validate_component "${component}" companion mac

if selected_component "${component}" "companion"; then
  install_app="${MARAITHON_COMPANION_DEV_APP_PATH:-${HOME}/Applications/Maraithon.app}"
  install_dir="$(dirname "${install_app}")"
  build_products_dir="${MARAITHON_COMPANION_BUILD_PRODUCTS_DIR:-${HOME}/Library/Caches/Maraithon/companion-build-products}"

  if companion_has_persistent_signing_config; then
    echo "Using pinned companion development signing."
  else
    ensure_companion_dev_signing
  fi
  mkdir -p "${install_dir}"
  mkdir -p "${build_products_dir}"

  # Build outside the FDA-granted app copy, then refresh the installed bundle
  # in place. Building directly into ~/Applications lets Xcode replace the
  # bundle macOS granted, which makes Full Disk Access appear to reset.
  MARAITHON_COMPANION_CONFIGURATION_BUILD_DIR="${build_products_dir}" \
    "${ROOT_DIR}/scripts/monorepo/build" companion
  built_app="${build_products_dir%/}/Maraithon.app"

  if [[ ! -d "${built_app}" ]]; then
    echo "Companion app was not built at ${built_app}" >&2
    exit 1
  fi

  # Keep the current app usable while the incremental Debug build runs. Only
  # stop it for the short in-place bundle refresh.
  quit_running_companion_app
  install_companion_dev_app "${built_app}" "${install_app}"
  xattr -dr com.apple.quarantine "${install_app}" >/dev/null 2>&1 || true
  if [[ -x "${LSREGISTER}" ]]; then
    "${LSREGISTER}" -u "${built_app}" >/dev/null 2>&1 || true
    "${LSREGISTER}" -f "${install_app}" >/dev/null 2>&1 || true
  fi
  record_companion_tcc_requirement "${install_app}"

  echo
  echo "Installed companion dev app at ${install_app}"
  echo "If Full Disk Access is already enabled for this app, this reload keeps using it."
  echo "If it is not enabled yet, grant this exact app path once; future reloads preserve it."
  open "${install_app}"
  # Cold SwiftUI launches can ignore a reopen event until scene registration
  # finishes. Retry the idempotent show-window URL briefly in the background
  # so this command returns immediately while the main window reliably opens.
  nohup /bin/bash -c '
    for delay in 2 3 5; do
      sleep "${delay}"
      open "maraithon://show"
    done
  ' </dev/null >/dev/null 2>&1 &
fi
